#!/usr/bin/env python3

import os
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
PYTHON = sys.executable
PROMPT_PATH = ROOT / "mission" / "bootstrap-prompt.txt"
PLAN_NEXT = ROOT / "scripts" / "plan-next"
EXECUTE_TASK = ROOT / "scripts" / "execute-task"
COMPLETE_TASK = ROOT / "scripts" / "complete-task"
BLOCK_TASK = ROOT / "scripts" / "block-task"
EVAL = ROOT / "scripts" / "eval"
SUMMARY_PREFIX = "COMPLETION_SUMMARY:"
BLOCK_PREFIX = "BLOCKED_BY_HUMAN:"


def run(command: list[str], allow_failure: bool = False) -> int:
    result = subprocess.run(command, cwd=ROOT)
    if result.returncode != 0 and not allow_failure:
        raise SystemExit(result.returncode)
    return result.returncode


def run_capture(command: list[str], allow_failure: bool = False) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(command, cwd=ROOT, capture_output=True, text=True)
    if result.stdout:
        print(result.stdout, end="")
    if result.stderr:
        print(result.stderr, end="", file=sys.stderr)
    if result.returncode != 0 and not allow_failure:
        raise SystemExit(result.returncode)
    return result


def extract_completion_summary(output: str) -> str | None:
    for raw_line in reversed(output.splitlines()):
        line = raw_line.strip()
        if line.startswith(SUMMARY_PREFIX):
            summary = line.removeprefix(SUMMARY_PREFIX).strip()
            if summary:
                return summary
    return None


def extract_block_reason(output: str) -> str | None:
    for raw_line in reversed(output.splitlines()):
        line = raw_line.strip()
        if line.startswith(BLOCK_PREFIX):
            reason = line.removeprefix(BLOCK_PREFIX).strip()
            if reason:
                return reason
    return None


def extract_task_id(output: str) -> str | None:
    for raw_line in output.splitlines():
        line = raw_line.strip()
        if line.startswith("task_id:"):
            task_id = line.removeprefix("task_id:").strip()
            if task_id:
                return task_id
    return None


def commit_message_for(summary: str, task_id: str | None) -> str:
    normalized = " ".join(summary.split())
    prefix = f"aos: {task_id} " if task_id else "aos: "
    max_summary_len = max(20, 72 - len(prefix))
    trimmed = normalized[:max_summary_len].rstrip()
    if len(normalized) > max_summary_len:
        trimmed = trimmed.rstrip(".,;: ") + "..."
    return prefix + trimmed


def main() -> int:
    max_iterations = int(os.environ.get("MAX_ITERATIONS", "30"))
    auto_commit = os.environ.get("AOS_AUTO_COMMIT", "0") == "1"
    idle_iterations = 0

    for iteration in range(1, max_iterations + 1):
        print(f"== Iteration {iteration}/{max_iterations} ==")

        execution_probe = subprocess.run(
            [str(EXECUTE_TASK), "--dry-run"],
            cwd=ROOT,
            capture_output=True,
            text=True,
        )
        print(execution_probe.stdout, end="")
        selected_task_id = extract_task_id(execution_probe.stdout)

        if execution_probe.returncode == 2:
            print("Task requires human review. Continuing to look for other work next iteration.")
            continue
        if execution_probe.returncode != 0:
            planning_result = run_capture([PYTHON, str(PLAN_NEXT)], allow_failure=True)
            if planning_result.returncode != 0:
                print("Planning failed. Episode stopping.")
                return planning_result.returncode

            if "PLANNING_COMPLETED" in planning_result.stdout:
                print("Planner created new safe tasks. Retrying selection in the next iteration.")
                continue

            idle_iterations += 1
            print("No executable safe task available right now.")
            if idle_iterations >= 3:
                print("Episode ended after repeated idle iterations.")
                return 0
            continue

        idle_iterations = 0

        status = run([str(EXECUTE_TASK)], allow_failure=True)
        if status not in (0,):
            print("Episode stopped: unable to start the selected task.")
            return status

        prompt = PROMPT_PATH.read_text()
        agent_run = run_capture(["opencode", "run", prompt], allow_failure=False)
        block_reason = extract_block_reason(agent_run.stdout)
        completion_summary = extract_completion_summary(agent_run.stdout)

        if block_reason:
            if not selected_task_id:
                print("Episode stopped: unable to identify the selected task for blocking.")
                return 1
            status = run([str(BLOCK_TASK), selected_task_id, "--reason", block_reason], allow_failure=True)
            if status != 0:
                print("Episode stopped: unable to record blocked task state.")
                return status
            print("Task blocked by human input request. Continuing to the next iteration.")
            continue

        if not completion_summary:
            print("Episode stopped: missing completion summary from agent output.")
            return 1

        status = run([str(EVAL)], allow_failure=True)
        if status != 0:
            print("Eval failed. Continue only if the next iteration is expected to fix it.")
            return status

        status = run([str(COMPLETE_TASK), "--summary", completion_summary], allow_failure=True)
        if status != 0:
            print("Episode stopped: unable to complete the current task.")
            return status

        status = run([str(EVAL)], allow_failure=True)
        if status != 0:
            print("Eval failed after task completion. Continue only if the next iteration is expected to fix it.")
            return status

        if auto_commit:
            run(["git", "status", "--short"], allow_failure=False)
            run(["git", "add", "README.md", "agents", "mission", "scripts"], allow_failure=False)
            run(["git", "commit", "-m", commit_message_for(completion_summary, selected_task_id)], allow_failure=True)
        else:
            print("AUTO_COMMIT_DISABLED")
            print("reason: leave completed iteration changes for human review and intentional batching")

    print("Episode limit reached without completion.")
    return 1


if __name__ == "__main__":
    sys.exit(main())
