#!/usr/bin/env python3

import os
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
PROMPT_PATH = ROOT / "mission" / "bootstrap-prompt.txt"
EXECUTE_TASK = ROOT / "scripts" / "execute-task"
COMPLETE_TASK = ROOT / "scripts" / "complete-task"
EVAL = ROOT / "scripts" / "eval"
SUMMARY_PREFIX = "COMPLETION_SUMMARY:"


def run(command: list[str], allow_failure: bool = False) -> int:
    result = subprocess.run(command, cwd=ROOT)
    if result.returncode != 0 and not allow_failure:
        raise SystemExit(result.returncode)
    return result.returncode


def run_capture(command: list[str], allow_failure: bool = False) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(command, cwd=ROOT, capture_output=True, text=True)
    if result.stdout:
        print(result.stdout, end="")
    if result.stderr:
        print(result.stderr, end="", file=sys.stderr)
    if result.returncode != 0 and not allow_failure:
        raise SystemExit(result.returncode)
    return result


def extract_completion_summary(output: str) -> str | None:
    for raw_line in reversed(output.splitlines()):
        line = raw_line.strip()
        if line.startswith(SUMMARY_PREFIX):
            summary = line.removeprefix(SUMMARY_PREFIX).strip()
            if summary:
                return summary
    return None


def main() -> int:
    max_iterations = int(os.environ.get("MAX_ITERATIONS", "30"))

    for iteration in range(1, max_iterations + 1):
        print(f"== Iteration {iteration}/{max_iterations} ==")

        execution_probe = subprocess.run(
            [str(EXECUTE_TASK), "--dry-run"],
            cwd=ROOT,
            capture_output=True,
            text=True,
        )
        print(execution_probe.stdout, end="")

        if execution_probe.returncode == 2:
            print("Episode stopped for human review.")
            return 2
        if execution_probe.returncode != 0:
            print("No executable safe task available.")
            return 1

        status = run([str(EXECUTE_TASK)], allow_failure=True)
        if status not in (0,):
            print("Episode stopped: unable to start the selected task.")
            return status

        prompt = PROMPT_PATH.read_text()
        agent_run = run_capture(["opencode", "run", prompt], allow_failure=False)
        completion_summary = extract_completion_summary(agent_run.stdout)
        if not completion_summary:
            print("Episode stopped: missing completion summary from agent output.")
            return 1

        status = run([str(EVAL)], allow_failure=True)
        if status != 0:
            print("Eval failed. Continue only if the next iteration is expected to fix it.")
            return status

        status = run([str(COMPLETE_TASK), "--summary", completion_summary], allow_failure=True)
        if status != 0:
            print("Episode stopped: unable to complete the current task.")
            return status

        status = run([str(EVAL)], allow_failure=True)
        if status != 0:
            print("Eval failed after task completion. Continue only if the next iteration is expected to fix it.")
            return status

        run(["git", "status", "--short"], allow_failure=False)
        run(["git", "add", "README.md", "agents", "mission", "scripts"], allow_failure=False)
        run(["git", "commit", "-m", f"agentic-os iteration {iteration}"], allow_failure=True)

    print("Episode limit reached without completion.")
    return 1


if __name__ == "__main__":
    sys.exit(main())
