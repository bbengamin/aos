#!/usr/bin/env python3

import sys

from plannerlib import audit_planner_candidates, planner_max_auto_tasks
from tasklib import add_task, append_execution_event, load_tasks, next_auto_task_id, pending_safe_tasks, save_tasks, utc_now


def main() -> int:
    data = load_tasks()
    max_auto_tasks = planner_max_auto_tasks()

    existing_auto = [task for task in data.get("tasks", []) if task.get("id", "").startswith("AUTO-")]
    if max_auto_tasks is not None and len(existing_auto) >= max_auto_tasks:
        print("PLANNING_SKIPPED")
        print("reason: auto task budget already exhausted")
        return 0

    existing_pending = pending_safe_tasks(data)
    if existing_pending:
        print("PLANNING_SKIPPED")
        print(f"reason: executable safe tasks already exist ({len(existing_pending)})")
        return 0

    planned = []
    timestamp = utc_now()
    for candidate in audit_planner_candidates(data, max_auto_tasks=max_auto_tasks):
        if candidate.get("status") != "eligible":
            continue
        task_id = next_auto_task_id(data)
        task = {
            "id": task_id,
            "title": candidate["title"],
            "theme": candidate["theme"],
            "status": "pending",
            "priority": candidate["priority"],
            "kind": candidate["kind"],
            "safe": True,
            "requires_human_review": False,
            "done_condition": candidate["done_condition"],
            "notes": candidate["notes"],
            "planning_reason": candidate["planning_reason"],
            "generator_key": candidate.get("generator_key"),
            "follow_up_batch": candidate.get("follow_up_batch"),
            "depends_on_task_ids": candidate.get("dependency_ids", []),
            "dependency_titles": candidate.get("dependency_titles", []),
            "planned_at": timestamp,
        }
        add_task(data, task)
        planned.append(task)

    if not planned:
        print("PLANNING_SKIPPED")
        print("reason: all eligible safe planner candidates are already covered")
        return 0

    save_tasks(data)

    append_execution_event(
        {
            "timestamp": timestamp,
            "event": "planned_next_tasks",
            "task_ids": [task["id"] for task in planned],
            "titles": [task["title"] for task in planned],
            "planning_reasons": [task["planning_reason"] for task in planned],
            "dependencies": [task.get("depends_on_task_ids", []) for task in planned],
        }
    )

    print("PLANNING_COMPLETED")
    for task in planned:
        print(f"planned_task_id: {task['id']}")
        print(f"title: {task['title']}")
        print(f"planning_reason: {task['planning_reason']}")
        if task.get("dependency_titles"):
            print(f"dependencies: {', '.join(task['dependency_titles'])}")
        print(f"done_condition: {task['done_condition']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
