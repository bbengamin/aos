PLANNER_BATCH_SIZE = 3
PLANNER_THEME_OPEN_LIMIT = 1


def template_already_covered(data: dict, template: dict) -> bool:
    for task in data.get("tasks", []):
        if task.get("title") != template["title"]:
            continue
        if task.get("done_condition") != template["done_condition"]:
            continue
        if task.get("status") in {"pending", "in_progress", "done"}:
            return True
    return False


def title_is_done(data: dict, title: str) -> bool:
    for task in data.get("tasks", []):
        if task.get("title") == title and task.get("status") == "done":
            return True
    return False


def template_is_eligible(data: dict, template: dict) -> bool:
    for required_title in template.get("requires_done_titles", []):
        if not title_is_done(data, required_title):
            return False
    return True


def open_theme_counts(data: dict) -> dict[str, int]:
    counts: dict[str, int] = {}
    for task in data.get("tasks", []):
        if task.get("status") not in {"pending", "in_progress"}:
            continue
        theme = task.get("theme")
        if not theme:
            continue
        counts[theme] = counts.get(theme, 0) + 1
    return counts


def main() -> int:
    data = load_tasks()
    max_auto_tasks = None
    raw_limit = os.environ.get("AOS_MAX_AUTO_TASKS")
    if raw_limit and raw_limit.isdigit():
        max_auto_tasks = int(raw_limit)

    existing_auto = [task for task in data.get("tasks", []) if task.get("id", "").startswith("AUTO-")]
    if max_auto_tasks is not None and len(existing_auto) >= max_auto_tasks:
        print("PLANNING_SKIPPED")
        print("reason: auto task budget already exhausted")
        return 0

    existing_pending = pending_safe_tasks(data)
    if existing_pending:
        print("PLANNING_SKIPPED")
        print(f"reason: executable safe tasks already exist ({len(existing_pending)})")
        return 0

    planned = []
    timestamp = utc_now()
    theme_counts = open_theme_counts(data)

    for template in SAFE_TASK_TEMPLATES:
        if len(planned) >= PLANNER_BATCH_SIZE:
            break
        if not template_is_eligible(data, template):
            continue
        if template_already_covered(data, template):
            continue
        if theme_counts.get(template["theme"], 0) >= PLANNER_THEME_OPEN_LIMIT:
            continue
        task_id = next_auto_task_id(data)
        task = {
            "id": task_id,
            "title": template["title"],
            "theme": template["theme"],
            "status": "pending",
            "priority": template["priority"],
            "kind": template["kind"],
            "safe": True,
            "requires_human_review": False,
            "done_condition": template["done_condition"],
            "notes": template["notes"],
            "planning_reason": template["planning_reason"],
            "planned_at": timestamp,
        }
        add_task(data, task)
        planned.append(task)
        theme_counts[task["theme"]] = theme_counts.get(task["theme"], 0) + 1

    if not planned:
        print("PLANNING_SKIPPED")
        print("reason: all eligible safe planner candidates are already covered")
        return 0

    save_tasks(data)

    append_execution_event(
        {
            "timestamp": timestamp,
            "event": "planned_next_tasks",
            "task_ids": [task["id"] for task in planned],
            "titles": [task["title"] for task in planned],
            "planning_reasons": [task["planning_reason"] for task in planned],
        }
    )

    print("PLANNING_COMPLETED")
    for task in planned:
        print(f"planned_task_id: {task['id']}")
        print(f"title: {task['title']}")
        print(f"planning_reason: {task['planning_reason']}")
        print(f"done_condition: {task['done_condition']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
