#!/usr/bin/env python3

import sys

from plannerlib import (
    audit_planner_candidates,
    planner_batch_consumer_ids,
    planner_batch_consumers,
    planner_gate_tasks,
    planner_max_auto_tasks,
)
from tasklib import load_tasks, pending_safe_tasks


def task_refs(tasks: list[dict]) -> list[str]:
    refs = []
    for task in tasks:
        task_id = task.get("id")
        title = task.get("title")
        status = task.get("status")
        if task_id and title and status:
            refs.append(f"{task_id}: {title} ({status})")
        elif task_id and title:
            refs.append(f"{task_id}: {title}")
        elif task_id:
            refs.append(task_id)
    return refs


def print_candidate(candidate: dict) -> None:
    print(f"{candidate['status'].upper()} {candidate['title']}")
    print(f"  theme: {candidate['theme']}")
    print(f"  reason: {candidate['reason']}")
    print(f"  done_condition: {candidate['done_condition']}")
    print(f"  planning_reason: {candidate['planning_reason']}")

    if candidate.get("generator_key"):
        print(f"  generator_key: {candidate['generator_key']}")

    if candidate.get("follow_up_batch"):
        print(f"  follow_up_batch: {candidate['follow_up_batch']}")

    dependency_titles = candidate.get("dependency_titles", [])
    if dependency_titles:
        print(f"  dependencies: {', '.join(dependency_titles)}")

    dependency_ids = candidate.get("dependency_ids", [])
    if dependency_ids:
        print(f"  dependency_ids: {', '.join(dependency_ids)}")

    dependency_task_refs = candidate.get("dependency_task_refs", [])
    if dependency_task_refs:
        print(f"  dependency_task_refs: {', '.join(dependency_task_refs)}")

    missing_titles = candidate.get("missing_required_titles", [])
    if missing_titles:
        print(f"  missing_required_titles: {', '.join(missing_titles)}")

    missing_task_states = candidate.get("missing_required_task_states", [])
    if missing_task_states:
        print(f"  missing_required_task_states: {', '.join(missing_task_states)}")

    if "theme_open_tasks" in candidate:
        print(f"  theme_open_tasks: {candidate['theme_open_tasks']}")

    theme_open_task_ids = candidate.get("theme_open_task_ids", [])
    if theme_open_task_ids:
        print(f"  theme_open_task_ids: {', '.join(theme_open_task_ids)}")

    theme_open_task_titles = candidate.get("theme_open_task_titles", [])
    if theme_open_task_titles:
        print(f"  theme_open_task_titles: {', '.join(theme_open_task_titles)}")

    planner_batch_task_titles = candidate.get("planner_batch_task_titles", [])
    if planner_batch_task_titles:
        print(f"  planner_batch_task_titles: {', '.join(planner_batch_task_titles)}")

    planner_batch_task_ids = candidate.get("planner_batch_task_ids", [])
    if planner_batch_task_ids:
        print(f"  planner_batch_task_ids: {', '.join(planner_batch_task_ids)}")

    if "auto_task_budget_limit" in candidate:
        print(f"  auto_task_budget_limit: {candidate['auto_task_budget_limit']}")

    if "auto_task_budget_count" in candidate:
        print(f"  auto_task_budget_count: {candidate['auto_task_budget_count']}")

    auto_task_ids = candidate.get("auto_task_ids", [])
    if auto_task_ids:
        print(f"  auto_task_ids: {', '.join(auto_task_ids)}")

    auto_task_refs = candidate.get("auto_task_refs", [])
    if auto_task_refs:
        print(f"  auto_task_refs: {', '.join(auto_task_refs)}")

    planner_batch_task_themes = candidate.get("planner_batch_task_themes", [])
    if planner_batch_task_themes:
        print(f"  planner_batch_task_themes: {', '.join(planner_batch_task_themes)}")

    planner_gate_task_ids = candidate.get("planner_gate_task_ids", [])
    if planner_gate_task_ids:
        print(f"  planner_gate_task_ids: {', '.join(planner_gate_task_ids)}")

    planner_gate_task_titles = candidate.get("planner_gate_task_titles", [])
    if planner_gate_task_titles:
        print(f"  planner_gate_task_titles: {', '.join(planner_gate_task_titles)}")

    planner_gate_task_states = candidate.get("planner_gate_task_states", [])
    if planner_gate_task_states:
        print(f"  planner_gate_task_states: {', '.join(planner_gate_task_states)}")

    if candidate.get("covering_task_id"):
        print(f"  covering_task_id: {candidate['covering_task_id']}")

    if candidate.get("covering_task_status"):
        print(f"  covering_task_status: {candidate['covering_task_status']}")


def main() -> int:
    data = load_tasks()
    candidates = audit_planner_candidates(data, max_auto_tasks=planner_max_auto_tasks())
    batch_consumers = planner_batch_consumers(candidates)
    pending = planner_gate_tasks(data)

    if batch_consumers:
        batch_titles = [candidate["title"] for candidate in batch_consumers]
        batch_ids = planner_batch_consumer_ids(data, batch_consumers)
        batch_themes = [candidate["theme"] for candidate in batch_consumers]
        for candidate in candidates:
            if candidate.get("reason") != "planner_batch_full":
                continue
            candidate["planner_batch_task_titles"] = batch_titles
            candidate["planner_batch_task_ids"] = batch_ids
            candidate["planner_batch_task_themes"] = batch_themes

    if pending:
        print("PLANNER_GATE blocked")
        print(f"planner_gate_reason: executable safe tasks already exist ({len(pending)})")
        print(f"planner_gate_task_ids: {', '.join(task['id'] for task in pending if task.get('id'))}")
        print(f"planner_gate_task_titles: {', '.join(task['title'] for task in pending if task.get('title'))}")
        print(
            "planner_gate_task_states: "
            + ", ".join(
                f"{task['id']}:{task['status']}"
                for task in pending
                if task.get("id") and task.get("status")
            )
        )
        print(f"planner_gate_task_refs: {', '.join(task_refs(pending))}")
    else:
        print("PLANNER_GATE ready")

    print(f"CANDIDATES {len(candidates)}")
    for status in ("covered", "eligible", "blocked"):
        print(f"{status.upper()}_COUNT {sum(1 for candidate in candidates if candidate['status'] == status)}")

    for candidate in candidates:
        print_candidate(candidate)

    return 0


if __name__ == "__main__":
    sys.exit(main())
