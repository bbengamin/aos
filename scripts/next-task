#!/usr/bin/env python3

import json
from pathlib import Path
import sys


def main() -> int:
    tasks_path = Path(__file__).resolve().parent.parent / "mission" / "tasks.json"
    data = json.loads(tasks_path.read_text())

    tasks = data.get("tasks", [])
    pending = [
        task
        for task in tasks
        if task.get("status") == "pending" and not task.get("requires_human_review", False)
    ]

    if not pending:
        print("NO_SAFE_PENDING_TASK")
        return 1

    priority_rank = {"high": 0, "medium": 1, "low": 2}
    pending.sort(key=lambda task: (priority_rank.get(task.get("priority"), 99), task.get("id", "")))
    task = pending[0]

    print(f"{task['id']}: {task['title']}")
    print(f"done_condition: {task['done_condition']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
