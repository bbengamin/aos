#!/usr/bin/env python3

import sys

from tasklib import load_tasks, next_safe_task


def main() -> int:
    task = next_safe_task(load_tasks())
    if not task:
        print("NO_SAFE_PENDING_TASK")
        return 1

    print(f"{task['id']}: {task['title']}")
    print(f"status: {task['status']}")
    print(f"done_condition: {task['done_condition']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
