            return ["plan-next did not keep generating safe work after the original three templates were completed"]

        updated_tasks = json.loads(tasks_path.read_text())
        new_auto_tasks = [task for task in updated_tasks.get("tasks", []) if task.get("id", "").startswith("AUTO-") and task.get("status") == "pending"]
        if not new_auto_tasks:
            return ["plan-next did not add any fresh AUTO-* task after the initial template set was exhausted"]

        if not any(task.get("title") == "Add supervisor cycle outcome summaries" for task in new_auto_tasks):
            return ["plan-next did not unlock the next eligible planner candidate after the initial template set was completed"]

        events = [json.loads(line) for line in execution_log_path.read_text().splitlines() if line.strip()]
        if not any(event.get("event") == "planned_next_tasks" for event in events):
            return ["plan-next did not log planned_next_tasks when progressing beyond the initial templates"]

    return []


def check_plan_next_limits_theme_breadth() -> list[str]:
    if os.environ.get("AOS_SKIP_PLAN_NEXT_CHECK") == "1":
        return []

    with tempfile.TemporaryDirectory() as tmp_dir:
        tmp_root = Path(tmp_dir) / "repo"
        shutil.copytree(ROOT, tmp_root, ignore=shutil.ignore_patterns(".git", "__pycache__", "logs"))

        tasks_path = tmp_root / "mission" / "tasks.json"
        tasks_data = {
            "version": 1,
            "updated_at": "2026-05-31T00:00:00Z",
            "tasks": [
                {
                    "id": "AUTO-1",
                    "title": "Add supervisor daemon for repeated AFK episodes",
                    "theme": "supervisor",
                    "status": "done",
                    "priority": "high",
                    "kind": "improvement",
                    "safe": True,
                    "requires_human_review": False,
                    "done_condition": "A local daemon script can launch bounded AFK episodes repeatedly, sleep in clean idle-blocked state, and resume when executable work appears.",
                    "completed_at": "2026-05-31T00:00:00Z",
                    "completion_summary": "Already completed.",
                },
                {
                    "id": "AUTO-2",
                    "title": "Add planner-generated task reporting",
                    "theme": "planner",
                    "status": "done",
                    "priority": "medium",
                    "kind": "improvement",
                    "safe": True,
                    "requires_human_review": False,
                    "done_condition": "The system records when and why new tasks were generated so humans can review planning decisions after AFK runs.",
                    "completed_at": "2026-05-31T00:00:00Z",
                    "completion_summary": "Already completed.",
                },
                {
                    "id": "AUTO-3",
                    "title": "Add idle-state status summary command",
                    "theme": "status",
                    "status": "done",
                    "priority": "medium",
                    "kind": "improvement",
                    "safe": True,
                    "requires_human_review": False,
                    "done_condition": "A status summary can distinguish active work, planned work, blocked work, and clean idle-blocked state in one command.",
                    "completed_at": "2026-05-31T00:00:00Z",
                    "completion_summary": "Already completed.",
                },
                {
                    "id": "RISK-ONLY",
                    "title": "Only blocked risk remains",
                    "status": "pending",
                    "priority": "medium",
                    "kind": "risk",
                    "safe": False,
                    "requires_human_review": True,
                    "blocked_by_human": True,
                    "done_condition": "Remain blocked.",
                    "blocker_reason": "Still waiting for human approval.",
                },
            ],
        }
        tasks_path.write_text(json.dumps(tasks_data, indent=2) + "\n")

        execution_log_path = tmp_root / "mission" / "execution-log.ndjson"
        execution_log_path.write_text("")

        plan_next_path = tmp_root / "scripts" / "plan-next"
        plan_next_path.chmod(plan_next_path.stat().st_mode | stat.S_IXUSR)

        env = os.environ.copy()
        env["AOS_SKIP_PLAN_NEXT_CHECK"] = "1"
        env.pop("AOS_MAX_AUTO_TASKS", None)

        result = subprocess.run(
            [str(plan_next_path)],
            cwd=tmp_root,
            capture_output=True,
            text=True,
            env=env,
        )

        if result.returncode != 0:
            return [f"plan-next did not enforce theme breadth cleanly: {result.stdout.strip()} {result.stderr.strip()}".strip()]

        updated_tasks = json.loads(tasks_path.read_text())
        new_auto_tasks = [task for task in updated_tasks.get("tasks", []) if task.get("id", "").startswith("AUTO-") and task.get("status") == "pending"]
        if len(new_auto_tasks) != 3:
            return ["plan-next did not create the expected breadth-limited planner batch"]

        titles = {task.get("title") for task in new_auto_tasks}
        expected_titles = {
            "Add supervisor cycle outcome summaries",
            "Add planner backlog breadth limits",
            "Add stale-work status indicators",
        }
        if titles != expected_titles:
            return ["plan-next did not rotate across distinct planner themes in the first post-bootstrap batch"]

        themes = [task.get("theme") for task in new_auto_tasks]
        if len(set(themes)) != len(themes):
            return ["plan-next allowed multiple pending tasks from the same planner theme in one breadth-limited batch"]

    return []


