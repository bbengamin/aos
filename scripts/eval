#!/usr/bin/env python3

import json
from pathlib import Path
import subprocess
import sys


ROOT = Path(__file__).resolve().parent.parent

REQUIRED_FILES = [
    "README.md",
    "mission/mission.md",
    "mission/constitution.md",
    "mission/resources.md",
    "mission/plan.md",
    "mission/tasks.json",
    "mission/execution-log.ndjson",
    "mission/decision-log.md",
    "mission/risk-log.md",
    "mission/evals.md",
    "agents/planner.md",
    "agents/builder.md",
    "agents/guardian.md",
    "scripts/next-task",
    "scripts/tasklib.py",
    "scripts/execute-task",
    "scripts/episode",
    "scripts/eval",
]


def check_files() -> list[str]:
    failures = []
    for relative_path in REQUIRED_FILES:
        if not (ROOT / relative_path).exists():
            failures.append(f"missing file: {relative_path}")
    return failures


def check_tasks() -> list[str]:
    failures = []
    tasks_path = ROOT / "mission" / "tasks.json"
    data = json.loads(tasks_path.read_text())
    tasks = data.get("tasks")
    if not isinstance(tasks, list) or not tasks:
        failures.append("tasks.json must contain at least one task")
        return failures

    required_keys = {"id", "title", "status", "done_condition"}
    for task in tasks:
        missing = required_keys - set(task.keys())
        if missing:
            failures.append(f"task {task.get('id', '<unknown>')} missing keys: {sorted(missing)}")
    return failures


def check_next_task() -> list[str]:
    result = subprocess.run(
        [str(ROOT / "scripts" / "next-task")],
        cwd=ROOT,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return [f"next-task failed: {result.stdout.strip()} {result.stderr.strip()}".strip()]
    if "done_condition:" not in result.stdout:
        return ["next-task output did not include a done condition"]
    return []


def check_execute_task() -> list[str]:
    result = subprocess.run(
        [str(ROOT / "scripts" / "execute-task"), "--dry-run"],
        cwd=ROOT,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return [f"execute-task dry run failed: {result.stdout.strip()} {result.stderr.strip()}".strip()]
    if "READY_TO_EXECUTE" not in result.stdout:
        return ["execute-task dry run did not report READY_TO_EXECUTE"]
    return []


def check_execution_log() -> list[str]:
    log_path = ROOT / "mission" / "execution-log.ndjson"
    lines = [line for line in log_path.read_text().splitlines() if line.strip()]
    if not lines:
        return ["execution-log.ndjson must contain at least one event"]
    try:
        json.loads(lines[-1])
    except json.JSONDecodeError as exc:
        return [f"execution-log.ndjson contains invalid JSON: {exc}"]
    return []


def check_plan() -> list[str]:
    plan_text = (ROOT / "mission" / "plan.md").read_text()
    if "Proposed Next Mission" not in plan_text:
        return ["plan.md must include 'Proposed Next Mission'"]
    return []


def check_review_gate() -> list[str]:
    data = json.loads((ROOT / "mission" / "tasks.json").read_text())
    has_review_task = any(task.get("requires_human_review", False) for task in data.get("tasks", []))
    if not has_review_task:
        return ["tasks.json must include at least one task gated by human review"]
    return []


def main() -> int:
    failures = []
    failures.extend(check_files())
    failures.extend(check_tasks())
    failures.extend(check_next_task())
    failures.extend(check_execute_task())
    failures.extend(check_execution_log())
    failures.extend(check_plan())
    failures.extend(check_review_gate())

    if failures:
        print("EVAL_FAIL")
        for failure in failures:
            print(f"- {failure}")
        return 1

    print("EVAL_PASS")
    print("bootstrap repository capabilities are present")
    return 0


if __name__ == "__main__":
    sys.exit(main())
