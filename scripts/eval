#!/usr/bin/env python3

import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parent.parent

REQUIRED_FILES = [
    "README.md",
    "mission/mission.md",
    "mission/constitution.md",
    "mission/resources.md",
    "mission/plan.md",
    "mission/tasks.json",
    "mission/execution-log.ndjson",
    "mission/decision-log.md",
    "mission/risk-log.md",
    "mission/evals.md",
    "agents/planner.md",
    "agents/builder.md",
    "agents/guardian.md",
    "scripts/next-task",
    "scripts/tasklib.py",
    "scripts/plan-next",
    "scripts/execute-task",
    "scripts/complete-task",
    "scripts/block-task",
    "scripts/unblock-task",
    "scripts/episode",
    "scripts/afk",
    "scripts/supervisor",
    "scripts/status",
    "scripts/eval",
]


def check_files() -> list[str]:
    failures = []
    for relative_path in REQUIRED_FILES:
        if not (ROOT / relative_path).exists():
            failures.append(f"missing file: {relative_path}")
    return failures


def check_tasks() -> list[str]:
    failures = []
    tasks_path = ROOT / "mission" / "tasks.json"
    data = json.loads(tasks_path.read_text())
    tasks = data.get("tasks")
    if not isinstance(tasks, list) or not tasks:
        failures.append("tasks.json must contain at least one task")
        return failures

    required_keys = {"id", "title", "status", "done_condition"}
    for task in tasks:
        missing = required_keys - set(task.keys())
        if missing:
            failures.append(f"task {task.get('id', '<unknown>')} missing keys: {sorted(missing)}")
    return failures


def check_completion_helper() -> list[str]:
    data = json.loads((ROOT / "mission" / "tasks.json").read_text())
    done_tasks = [task for task in data.get("tasks", []) if task.get("status") == "done"]
    completed_with_summary = [task for task in done_tasks if task.get("completion_summary")]
    if not completed_with_summary:
        return ["tasks.json must include at least one done task with completion_summary"]

    log_path = ROOT / "mission" / "execution-log.ndjson"
    events = [json.loads(line) for line in log_path.read_text().splitlines() if line.strip()]
    if not any(event.get("event") == "completed" and event.get("summary") for event in events):
        return ["execution-log.ndjson must include a completed event with summary"]
    return []


def no_executable_safe_task_is_expected() -> bool:
    data = json.loads((ROOT / "mission" / "tasks.json").read_text())

    current_safe = any(
        task.get("status") == "in_progress"
        and task.get("safe", False)
        and not task.get("requires_human_review", False)
        for task in data.get("tasks", [])
    )
    if current_safe:
        return False

    pending_safe = any(
        task.get("status") == "pending"
        and task.get("safe", False)
        and not task.get("requires_human_review", False)
        and not task.get("blocked_by_human", False)
        for task in data.get("tasks", [])
    )
    return not pending_safe


def check_next_task() -> list[str]:
    result = subprocess.run(
        [str(ROOT / "scripts" / "next-task")],
        cwd=ROOT,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        if result.stdout.strip() == "NO_SAFE_PENDING_TASK" and no_executable_safe_task_is_expected():
            return []
        return [f"next-task failed: {result.stdout.strip()} {result.stderr.strip()}".strip()]
    if "done_condition:" not in result.stdout:
        return ["next-task output did not include a done condition"]
    return []


def check_execute_task() -> list[str]:
    result = subprocess.run(
        [str(ROOT / "scripts" / "execute-task"), "--dry-run"],
        cwd=ROOT,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        if result.stdout.strip() == "NO_EXECUTABLE_TASK" and no_executable_safe_task_is_expected():
            return []
        return [f"execute-task dry run failed: {result.stdout.strip()} {result.stderr.strip()}".strip()]
    if "READY_TO_EXECUTE" not in result.stdout:
        return ["execute-task dry run did not report READY_TO_EXECUTE"]
    return []


def check_execution_log() -> list[str]:
    log_path = ROOT / "mission" / "execution-log.ndjson"
    lines = [line for line in log_path.read_text().splitlines() if line.strip()]
    if not lines:
        return ["execution-log.ndjson must contain at least one event"]
    try:
        json.loads(lines[-1])
    except json.JSONDecodeError as exc:
        return [f"execution-log.ndjson contains invalid JSON: {exc}"]
    return []


def check_plan() -> list[str]:
    plan_text = (ROOT / "mission" / "plan.md").read_text()
    if "Proposed Next Mission" not in plan_text:
        return ["plan.md must include 'Proposed Next Mission'"]
    return []


def check_review_gate() -> list[str]:
    data = json.loads((ROOT / "mission" / "tasks.json").read_text())
    has_review_task = any(task.get("requires_human_review", False) for task in data.get("tasks", []))
    if not has_review_task:
        return ["tasks.json must include at least one task gated by human review"]
    return []


def check_blocker_model() -> list[str]:
    data = json.loads((ROOT / "mission" / "tasks.json").read_text())
    blocked = [task for task in data.get("tasks", []) if task.get("blocked_by_human", False)]
    if not blocked:
        return ["tasks.json must include at least one task blocked_by_human"]

    blocked_ids = {task.get("id") for task in blocked}

    next_task_result = subprocess.run(
        [str(ROOT / "scripts" / "next-task")],
        cwd=ROOT,
        capture_output=True,
        text=True,
    )
    if next_task_result.returncode != 0:
        if next_task_result.stdout.strip() == "NO_SAFE_PENDING_TASK" and no_executable_safe_task_is_expected():
            next_task_result = None
        else:
            return [f"next-task failed while checking blockers: {next_task_result.stdout.strip()} {next_task_result.stderr.strip()}".strip()]

    if next_task_result is not None:
        selected_id = next_task_result.stdout.split(":", 1)[0].strip()
        if selected_id in blocked_ids:
            return ["next-task selected a blocked_by_human task"]

    result = subprocess.run(
        [str(ROOT / "scripts" / "status")],
        cwd=ROOT,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return [f"status script failed: {result.stdout.strip()} {result.stderr.strip()}".strip()]
    if "STATE " not in result.stdout:
        return ["status script output did not include an overall state summary"]
    if "CLEAN_IDLE_BLOCKED " not in result.stdout:
        return ["status script output did not include a clean idle-blocked summary"]
    if "PLANNED_WORK " not in result.stdout:
        return ["status script output did not include planned work summary"]
    if "BLOCKERS" not in result.stdout:
        return ["status script output did not include blocker summary"]
    if "BLOCKED " not in result.stdout:
        return ["status script output did not list blocked tasks separately"]
    return []


def check_status_summary_modes() -> list[str]:
    if os.environ.get("AOS_SKIP_STATUS_SUMMARY_CHECK") == "1":
        return []

    failures = []

    with tempfile.TemporaryDirectory() as tmp_dir:
        tmp_root = Path(tmp_dir) / "repo"
        shutil.copytree(ROOT, tmp_root, ignore=shutil.ignore_patterns(".git", "__pycache__", "logs"))

        status_path = tmp_root / "scripts" / "status"
        status_path.chmod(status_path.stat().st_mode | stat.S_IXUSR)

        scenarios = [
            (
                "active",
                {
                    "version": 1,
                    "updated_at": "2026-05-31T00:00:00Z",
                    "tasks": [
                        {
                            "id": "ACTIVE-1",
                            "title": "Current active task",
                            "status": "in_progress",
                            "priority": "high",
                            "kind": "improvement",
                            "safe": True,
                            "requires_human_review": False,
                            "done_condition": "Continue active work.",
                        }
                    ],
                },
                ["STATE active", "CLEAN_IDLE_BLOCKED no", "CURRENT ACTIVE-1", "PLANNED_WORK 0", "BLOCKERS 0"],
            ),
            (
                "planned",
                {
                    "version": 1,
                    "updated_at": "2026-05-31T00:00:00Z",
                    "tasks": [
                        {
                            "id": "AUTO-1",
                            "title": "Planned follow-up",
                            "status": "pending",
                            "priority": "medium",
                            "kind": "improvement",
                            "safe": True,
                            "requires_human_review": False,
                            "done_condition": "Remain pending.",
                            "planning_reason": "Planned by the local planner.",
                        }
                    ],
                },
                ["STATE planned", "CLEAN_IDLE_BLOCKED no", "CURRENT none", "NEXT AUTO-1", "PLANNED_WORK 1", "PLANNED AUTO-1", "BLOCKERS 0"],
            ),
            (
                "clean_idle_blocked",
                {
                    "version": 1,
                    "updated_at": "2026-05-31T00:00:00Z",
                    "tasks": [
                        {
                            "id": "BLOCKED-1",
                            "title": "Waiting on human unblock",
                            "status": "pending",
                            "priority": "medium",
                            "kind": "risk",
                            "safe": True,
                            "requires_human_review": False,
                            "blocked_by_human": True,
                            "blocker_reason": "Need human input.",
                            "done_condition": "Remain blocked.",
                        }
                    ],
                },
                ["STATE clean_idle_blocked", "CLEAN_IDLE_BLOCKED yes", "CURRENT none", "NEXT none", "PLANNED_WORK 0", "BLOCKERS 1", "BLOCKED BLOCKED-1"],
            ),
            (
                "blocked",
                {
                    "version": 1,
                    "updated_at": "2026-05-31T00:00:00Z",
                    "tasks": [
                        {
                            "id": "REVIEW-1",
                            "title": "Pending human review gate",
                            "status": "pending",
                            "priority": "high",
                            "kind": "risk",
                            "safe": False,
                            "requires_human_review": True,
                            "done_condition": "Remain review-gated.",
                        },
                        {
                            "id": "BLOCKED-1",
                            "title": "Waiting on human unblock",
                            "status": "pending",
                            "priority": "medium",
                            "kind": "risk",
                            "safe": True,
                            "requires_human_review": False,
                            "blocked_by_human": True,
                            "blocker_reason": "Need human input.",
                            "done_condition": "Remain blocked.",
                        }
                    ],
                },
                ["STATE blocked", "CLEAN_IDLE_BLOCKED no", "CURRENT none", "NEXT none", "PLANNED_WORK 0", "BLOCKERS 1", "BLOCKED BLOCKED-1"],
            ),
        ]

        tasks_path = tmp_root / "mission" / "tasks.json"

        for scenario_name, tasks_data, expected_bits in scenarios:
            tasks_path.write_text(json.dumps(tasks_data, indent=2) + "\n")
            result = subprocess.run(
                [str(status_path)],
                cwd=tmp_root,
                capture_output=True,
                text=True,
                env={**os.environ, "AOS_SKIP_STATUS_SUMMARY_CHECK": "1"},
            )
            if result.returncode != 0:
                failures.append(
                    f"status script failed in {scenario_name} summary integration check: {result.stdout.strip()} {result.stderr.strip()}".strip()
                )
                continue
            for expected in expected_bits:
                if expected not in result.stdout:
                    failures.append(f"status script did not report {expected!r} in the {scenario_name} summary integration check")

    return failures


def check_status_last_plan_summary() -> list[str]:
    if os.environ.get("AOS_SKIP_STATUS_SUMMARY_CHECK") == "1":
        return []

    with tempfile.TemporaryDirectory() as tmp_dir:
        tmp_root = Path(tmp_dir) / "repo"
        shutil.copytree(ROOT, tmp_root, ignore=shutil.ignore_patterns(".git", "__pycache__", "logs"))

        tasks_path = tmp_root / "mission" / "tasks.json"
        tasks_path.write_text(
            json.dumps(
                {
                    "version": 1,
                    "updated_at": "2026-05-31T00:00:00Z",
                    "tasks": [
                        {
                            "id": "DONE-1",
                            "title": "Finished planned task",
                            "status": "done",
                            "priority": "medium",
                            "kind": "improvement",
                            "safe": True,
                            "requires_human_review": False,
                            "done_condition": "Remain done.",
                            "completed_at": "2026-05-31T00:00:00Z",
                            "completion_summary": "Already finished.",
                        }
                    ],
                },
                indent=2,
            )
            + "\n"
        )

        execution_log_path = tmp_root / "mission" / "execution-log.ndjson"
        execution_log_path.write_text(
            json.dumps(
                {
                    "timestamp": "2026-05-31T00:00:00Z",
                    "event": "planned_next_tasks",
                    "task_ids": ["AUTO-9"],
                    "titles": ["Add planner-generated task reporting"],
                    "planning_reasons": ["Humans need a durable planner rationale summary after AFK runs."],
                }
            )
            + "\n"
        )

        result = subprocess.run(
            [str(tmp_root / "scripts" / "status")],
            cwd=tmp_root,
            capture_output=True,
            text=True,
            env={**os.environ, "AOS_SKIP_STATUS_SUMMARY_CHECK": "1"},
        )
        if result.returncode != 0:
            return [f"status script failed in latest-plan integration check: {result.stdout.strip()} {result.stderr.strip()}".strip()]
        if "LAST_PLAN 2026-05-31T00:00:00Z" not in result.stdout:
            return ["status script did not show the latest planning event timestamp"]
        if "LAST_PLANNED AUTO-9: Add planner-generated task reporting" not in result.stdout:
            return ["status script did not show the latest planned task summary"]
        if "planning_reason: Humans need a durable planner rationale summary after AFK runs." not in result.stdout:
            return ["status script did not show the latest planning reason summary"]

    return []


def check_blocker_commands() -> list[str]:
    block_text = (ROOT / "scripts" / "block-task").read_text()
    unblock_text = (ROOT / "scripts" / "unblock-task").read_text()

    failures = []
    if "blocked_by_human" not in block_text:
        failures.append("block-task must set blocked_by_human")
    if "unblocked_by_human" not in unblock_text:
        failures.append("unblock-task must record an unblocked_by_human event")
    return failures


def check_planning_loop() -> list[str]:
    planner_text = (ROOT / "scripts" / "plan-next").read_text()
    episode_text = (ROOT / "scripts" / "episode").read_text()

    failures = []
    if "SAFE_TASK_TEMPLATES" not in planner_text:
        failures.append("plan-next must define safe task templates")
    if "planned_next_tasks" not in planner_text:
        failures.append("plan-next must log planned_next_tasks events")
    if "planning_reason" not in planner_text:
        failures.append("plan-next must record planning_reason for generated tasks")
    if "PLAN_NEXT" not in episode_text:
        failures.append("episode must wire in plan-next")
    if "PLANNING_COMPLETED" not in episode_text:
        failures.append("episode must react to planner-created tasks")
    return failures


def check_plan_next_generates_tasks() -> list[str]:
    if os.environ.get("AOS_SKIP_PLAN_NEXT_CHECK") == "1":
        return []

    with tempfile.TemporaryDirectory() as tmp_dir:
        tmp_root = Path(tmp_dir) / "repo"
        shutil.copytree(ROOT, tmp_root, ignore=shutil.ignore_patterns(".git", "__pycache__", "logs"))

        tasks_path = tmp_root / "mission" / "tasks.json"
        tasks_data = {
            "version": 1,
            "updated_at": "2026-05-31T00:00:00Z",
            "tasks": [
                {
                    "id": "DONE-1",
                    "title": "Seed completed task",
                    "status": "done",
                    "priority": "low",
                    "kind": "bootstrap",
                    "safe": True,
                    "requires_human_review": False,
                    "done_condition": "Seed completion evidence exists.",
                    "completed_at": "2026-05-31T00:00:00Z",
                    "completion_summary": "Seed completion evidence.",
                },
                {
                    "id": "RISK-ONLY",
                    "title": "Only blocked risk remains",
                    "status": "pending",
                    "priority": "medium",
                    "kind": "risk",
                    "safe": False,
                    "requires_human_review": True,
                    "blocked_by_human": True,
                    "done_condition": "Remain blocked.",
                    "blocker_reason": "Still waiting for human approval.",
                },
            ],
        }
        tasks_path.write_text(json.dumps(tasks_data, indent=2) + "\n")

        execution_log_path = tmp_root / "mission" / "execution-log.ndjson"
        execution_log_path.write_text(
            json.dumps(
                {
                    "timestamp": "2026-05-31T00:00:00Z",
                    "event": "completed",
                    "task_id": "DONE-1",
                    "title": "Seed completed task",
                    "summary": "Seed completion evidence.",
                }
            )
            + "\n"
        )

        plan_next_path = tmp_root / "scripts" / "plan-next"
        plan_next_path.chmod(plan_next_path.stat().st_mode | stat.S_IXUSR)

        env = os.environ.copy()
        env["AOS_SKIP_PLAN_NEXT_CHECK"] = "1"

        result = subprocess.run(
            [str(tmp_root / "scripts" / "plan-next")],
            cwd=tmp_root,
            capture_output=True,
            text=True,
            env=env,
        )

        if result.returncode != 0:
            return [f"plan-next did not complete cleanly in integration check: {result.stdout.strip()} {result.stderr.strip()}".strip()]

        updated_tasks = json.loads(tasks_path.read_text())
        planned = [task for task in updated_tasks.get("tasks", []) if task.get("id", "").startswith("AUTO-")]
        if not planned:
            return ["plan-next did not create any AUTO-* tasks when no executable safe work existed"]
        if not all(task.get("planning_reason") for task in planned):
            return ["plan-next did not record planning_reason on every generated AUTO-* task"]

        events = [json.loads(line) for line in execution_log_path.read_text().splitlines() if line.strip()]
        planning_events = [event for event in events if event.get("event") == "planned_next_tasks"]
        if not planning_events:
            return ["plan-next did not log planned_next_tasks in the execution log"]
        if not planning_events[-1].get("planning_reasons"):
            return ["plan-next did not log planning_reasons in the execution log"]

    return []


