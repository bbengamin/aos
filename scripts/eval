                    failures.append(f"status script did not report {expected!r} in the {scenario_name} summary integration check")

    return failures


def check_status_last_plan_summary() -> list[str]:
    if os.environ.get("AOS_SKIP_STATUS_SUMMARY_CHECK") == "1":
        return []

    with tempfile.TemporaryDirectory() as tmp_dir:
        tmp_root = Path(tmp_dir) / "repo"
        shutil.copytree(ROOT, tmp_root, ignore=shutil.ignore_patterns(".git", "__pycache__", "logs"))
        planner_candidates_path = tmp_root / "scripts" / "planner-candidates"
        planner_candidates_path.chmod(planner_candidates_path.stat().st_mode | stat.S_IXUSR)

        tasks_path = tmp_root / "mission" / "tasks.json"
        tasks_path.write_text(
            json.dumps(
                {
                    "version": 1,
                    "updated_at": "2026-05-31T00:00:00Z",
                    "tasks": [
                        {
                            "id": "DONE-1",
                            "title": "Finished planned task",
                            "status": "done",
                            "priority": "medium",
                            "kind": "improvement",
                            "safe": True,
                            "requires_human_review": False,
                            "done_condition": "Remain done.",
                            "completed_at": "2026-05-31T00:00:00Z",
                            "completion_summary": "Already finished.",
                        }
                    ],
                },
                indent=2,
            )
            + "\n"
        )

        execution_log_path = tmp_root / "mission" / "execution-log.ndjson"
        execution_log_path.write_text(
            json.dumps(
                {
                    "timestamp": "2026-05-31T00:00:00Z",
                    "event": "planned_next_tasks",
                    "task_ids": ["AUTO-9"],
                    "titles": ["Add planner-generated task reporting"],
                    "planning_reasons": ["Humans need a durable planner rationale summary after AFK runs."],
                }
            )
            + "\n"
        )

        result = subprocess.run(
            [str(tmp_root / "scripts" / "status")],
            cwd=tmp_root,
            capture_output=True,
            text=True,
            env={**os.environ, "AOS_SKIP_STATUS_SUMMARY_CHECK": "1"},
        )
        if result.returncode != 0:
            return [f"status script failed in latest-plan integration check: {result.stdout.strip()} {result.stderr.strip()}".strip()]
        if "LAST_PLAN 2026-05-31T00:00:00Z" not in result.stdout:
            return ["status script did not show the latest planning event timestamp"]
        if "LAST_PLANNED AUTO-9: Add planner-generated task reporting" not in result.stdout:
            return ["status script did not show the latest planned task summary"]
        if "planning_reason: Humans need a durable planner rationale summary after AFK runs." not in result.stdout:
            return ["status script did not show the latest planning reason summary"]

    return []


def check_status_stale_work_indicators() -> list[str]:
    if os.environ.get("AOS_SKIP_STATUS_SUMMARY_CHECK") == "1":
        return []

    with tempfile.TemporaryDirectory() as tmp_dir:
        tmp_root = Path(tmp_dir) / "repo"
        shutil.copytree(ROOT, tmp_root, ignore=shutil.ignore_patterns(".git", "__pycache__", "logs"))
        planner_candidates_path = tmp_root / "scripts" / "planner-candidates"
        planner_candidates_path.chmod(planner_candidates_path.stat().st_mode | stat.S_IXUSR)

        tasks_path = tmp_root / "mission" / "tasks.json"
        tasks_path.write_text(
            json.dumps(
                {
                    "version": 1,
                    "updated_at": "2026-05-31T00:00:00Z",
                    "tasks": [
                        {
                            "id": "ACTIVE-STALE-1",
                            "title": "Old in-progress task",
                            "status": "in_progress",
                            "priority": "high",
                            "kind": "improvement",
                            "safe": True,
                            "requires_human_review": False,
                            "done_condition": "Remain active.",
                            "started_at": "2026-05-28T00:00:00Z",
                        },
                        {
                            "id": "BLOCKED-OLD-1",
                            "title": "Old blocked task",
                            "status": "pending",
                            "priority": "medium",
                            "kind": "risk",
                            "safe": True,
                            "requires_human_review": False,
                            "blocked_by_human": True,
                            "blocked_at": "2026-05-25T00:00:00Z",
                            "blocker_reason": "Need a human decision.",
                            "done_condition": "Remain blocked.",
                        },
                    ],
                },
                indent=2,
            )
            + "\n"
        )

        result = subprocess.run(
            [str(tmp_root / "scripts" / "status")],
            cwd=tmp_root,
            capture_output=True,
            text=True,
            env={**os.environ, "AOS_SKIP_STATUS_SUMMARY_CHECK": "1"},
        )
        if result.returncode != 0:
            return [f"status script failed in stale-work integration check: {result.stdout.strip()} {result.stderr.strip()}".strip()]

        failures = []
        for expected in [
            "STATUS_POSTURE stale_active",
            "WORK_INVENTORY active=1 planned=0 review=0 blocked=1 dependency_waiting=0 stale=2",
            "QUEUE_HEALTH stale_active",
            "HUMAN_INPUT_QUEUE review=0 blocked=1 total=1",
            "EXECUTABLE_SAFE_TASKS 1",
            "ATTENTION_REQUIRED stale",
            "NEXT_ACTION investigate_stale_work",
            "NEXT_STEP investigate_stale_work ACTIVE-STALE-1: Old in-progress task",
            "WAITING_ON human_unblock",
            "ATTENTION_TASK ACTIVE-STALE-1: Old in-progress task",
            "NEXT_ACTION_TASK ACTIVE-STALE-1: Old in-progress task",
            "STALE_IN_PROGRESS 1",
            "STALE CURRENT ACTIVE-STALE-1: Old in-progress task",
            "LONG_BLOCKED 1",
            "STALE BLOCKED BLOCKED-OLD-1: Old blocked task",
            "attention: stale_in_progress",
            "attention: long_blocked",
        ]:
            if expected not in result.stdout:
                failures.append(f"status script did not report {expected!r} in the stale-work integration check")
        return failures


def check_blocker_commands() -> list[str]:
    block_text = (ROOT / "scripts" / "block-task").read_text()
    unblock_text = (ROOT / "scripts" / "unblock-task").read_text()

    failures = []
    if "blocked_by_human" not in block_text:
        failures.append("block-task must set blocked_by_human")
    if "unblocked_by_human" not in unblock_text:
        failures.append("unblock-task must record an unblocked_by_human event")
    return failures


def check_planning_loop() -> list[str]:
    planner_text = (ROOT / "scripts" / "plan-next").read_text()
    plannerlib_text = (ROOT / "scripts" / "plannerlib.py").read_text()
    planner_audit_text = (ROOT / "scripts" / "planner-candidates").read_text()
    episode_text = (ROOT / "scripts" / "episode").read_text()

    failures = []
    if "audit_planner_candidates" not in planner_text:
        failures.append("plan-next must build tasks from audited planner candidates")
    if "planned_next_tasks" not in planner_text:
        failures.append("plan-next must log planned_next_tasks events")
    if "planning_reason" not in planner_text:
        failures.append("plan-next must record planning_reason for generated tasks")
    if "FOLLOW_UP_TEMPLATE_SPECS" not in plannerlib_text:
        failures.append("plannerlib must define open-ended follow-up planner specs")
    if "generated_follow_up_templates" not in plannerlib_text:
        failures.append("plannerlib must synthesize follow-up planner candidates")
    if "all_planner_templates" not in plannerlib_text:
        failures.append("plannerlib must combine static and generated planner candidates")
    if "PLANNER_THEME_OPEN_LIMIT" not in plannerlib_text:
        failures.append("plannerlib must define a planner theme breadth limit")
    if 'theme_counts.get(template["theme"], 0) >= PLANNER_THEME_OPEN_LIMIT' not in plannerlib_text:
        failures.append("plan-next must limit how many open tasks one planner theme can contribute at once")
    if 'for status in ("covered", "eligible", "blocked")' not in planner_audit_text:
        failures.append("planner-candidates must summarize covered, eligible, and blocked planner candidates")
    if "PLAN_NEXT" not in episode_text:
        failures.append("episode must wire in plan-next")
    if "PLANNING_COMPLETED" not in episode_text:
        failures.append("episode must react to planner-created tasks")
    return failures


def check_plan_next_generates_tasks() -> list[str]:
    if os.environ.get("AOS_SKIP_PLAN_NEXT_CHECK") == "1":
        return []

    with tempfile.TemporaryDirectory() as tmp_dir:
        tmp_root = Path(tmp_dir) / "repo"
        shutil.copytree(ROOT, tmp_root, ignore=shutil.ignore_patterns(".git", "__pycache__", "logs"))
        planner_candidates_path = tmp_root / "scripts" / "planner-candidates"
        planner_candidates_path.chmod(planner_candidates_path.stat().st_mode | stat.S_IXUSR)

        tasks_path = tmp_root / "mission" / "tasks.json"
        tasks_data = {
            "version": 1,
            "updated_at": "2026-05-31T00:00:00Z",
            "tasks": [
                {
                    "id": "DONE-1",
                    "title": "Seed completed task",
                    "status": "done",
                    "priority": "low",
                    "kind": "bootstrap",
                    "safe": True,
                    "requires_human_review": False,
                    "done_condition": "Seed completion evidence exists.",
                    "completed_at": "2026-05-31T00:00:00Z",
                    "completion_summary": "Seed completion evidence.",
                },
                {
                    "id": "RISK-ONLY",
                    "title": "Only blocked risk remains",
                    "status": "pending",
                    "priority": "medium",
                    "kind": "risk",
                    "safe": False,
                    "requires_human_review": True,
                    "blocked_by_human": True,
                    "done_condition": "Remain blocked.",
                    "blocker_reason": "Still waiting for human approval.",
                },
            ],
        }
        tasks_path.write_text(json.dumps(tasks_data, indent=2) + "\n")

        execution_log_path = tmp_root / "mission" / "execution-log.ndjson"
        execution_log_path.write_text(
            json.dumps(
                {
                    "timestamp": "2026-05-31T00:00:00Z",
                    "event": "completed",
                    "task_id": "DONE-1",
                    "title": "Seed completed task",
                    "summary": "Seed completion evidence.",
                }
            )
            + "\n"
        )

        plan_next_path = tmp_root / "scripts" / "plan-next"
        plan_next_path.chmod(plan_next_path.stat().st_mode | stat.S_IXUSR)

        env = os.environ.copy()
        env["AOS_SKIP_PLAN_NEXT_CHECK"] = "1"

        result = subprocess.run(
            [str(tmp_root / "scripts" / "plan-next")],
            cwd=tmp_root,
            capture_output=True,
            text=True,
            env=env,
        )

        if result.returncode != 0:
            return [f"plan-next did not complete cleanly in integration check: {result.stdout.strip()} {result.stderr.strip()}".strip()]

        updated_tasks = json.loads(tasks_path.read_text())
        planned = [task for task in updated_tasks.get("tasks", []) if task.get("id", "").startswith("AUTO-")]
        if not planned:
            return ["plan-next did not create any AUTO-* tasks when no executable safe work existed"]
        if not all(task.get("planning_reason") for task in planned):
            return ["plan-next did not record planning_reason on every generated AUTO-* task"]

        events = [json.loads(line) for line in execution_log_path.read_text().splitlines() if line.strip()]
        planning_events = [event for event in events if event.get("event") == "planned_next_tasks"]
        if not planning_events:
            return ["plan-next did not log planned_next_tasks in the execution log"]
        if not planning_events[-1].get("planning_reasons"):
            return ["plan-next did not log planning_reasons in the execution log"]

    return []


def check_dependency_aware_selection() -> list[str]:
    if os.environ.get("AOS_SKIP_STATUS_SUMMARY_CHECK") == "1":
        return []

    with tempfile.TemporaryDirectory() as tmp_dir:
        tmp_root = Path(tmp_dir) / "repo"
        shutil.copytree(ROOT, tmp_root, ignore=shutil.ignore_patterns(".git", "__pycache__", "logs"))

        tasks_path = tmp_root / "mission" / "tasks.json"
        tasks_path.write_text(
            json.dumps(
                {
                    "version": 1,
                    "updated_at": "2026-05-31T00:00:00Z",
                    "tasks": [
                        {
                            "id": "DONE-1",
                            "title": "Finished prerequisite",
                            "status": "done",
                            "priority": "medium",
                            "kind": "improvement",
                            "safe": True,
                            "requires_human_review": False,
                            "done_condition": "Remain done.",
                            "completed_at": "2026-05-31T00:00:00Z",
                            "completion_summary": "Prerequisite already complete.",
                        },
                        {
                            "id": "WAIT-1",
                            "title": "Task waiting on unresolved dependency",
                            "status": "pending",
                            "priority": "high",
                            "kind": "improvement",
                            "safe": True,
                            "requires_human_review": False,
                            "done_condition": "Wait for missing dependency.",
                            "dependency_titles": ["Missing prerequisite"],
                            "depends_on_task_ids": ["MISSING-1"],
                        },
                        {
                            "id": "READY-1",
                            "title": "Task with resolved dependency",
                            "status": "pending",
                            "priority": "medium",
                            "kind": "improvement",
                            "safe": True,
                            "requires_human_review": False,
                            "done_condition": "Be selected next.",
                            "dependency_titles": ["Finished prerequisite"],
                            "depends_on_task_ids": ["DONE-1"],
                        },
                    ],
                },
                indent=2,
            )
            + "\n"
        )

        next_task_result = subprocess.run(
            [str(tmp_root / "scripts" / "next-task")],
            cwd=tmp_root,
            capture_output=True,
            text=True,
            env={**os.environ, "AOS_SKIP_STATUS_SUMMARY_CHECK": "1"},
        )
        if next_task_result.returncode != 0:
            return [
                f"next-task failed in dependency integration check: {next_task_result.stdout.strip()} {next_task_result.stderr.strip()}".strip()
            ]
        if "READY-1: Task with resolved dependency" not in next_task_result.stdout:
            return ["next-task did not skip a task with unresolved dependencies in favor of a ready task"]
        if "dependencies: Finished prerequisite" not in next_task_result.stdout:
            return ["next-task did not print dependency hints for the selected task"]

        status_result = subprocess.run(
            [str(tmp_root / "scripts" / "status")],
            cwd=tmp_root,
            capture_output=True,
            text=True,
            env={**os.environ, "AOS_SKIP_STATUS_SUMMARY_CHECK": "1"},
        )
        if status_result.returncode != 0:
            return [
                f"status failed in dependency integration check: {status_result.stdout.strip()} {status_result.stderr.strip()}".strip()
            ]

        failures = []
        for expected in [
            "STATE planned",
            "STATE_REASON ready_safe_backlog",
            "STATUS_POSTURE ready_and_waiting_on_dependencies",
            "WORK_INVENTORY active=0 planned=1 review=0 blocked=0 dependency_waiting=1 stale=0",
            "QUEUE_HEALTH mixed_ready_and_dependencies",
            "HUMAN_INPUT_QUEUE review=0 blocked=0 total=0",
            "EXECUTABLE_SAFE_TASKS 1",
            "ATTENTION_REQUIRED none",
            "NEXT_ACTION execute_next_safe_task",
            "NEXT_STEP execute_next_safe_task READY-1: Task with resolved dependency",
            "WAITING_ON dependencies",
            "NEXT_ACTION_TASK READY-1: Task with resolved dependency",
            "NEXT READY-1: Task with resolved dependency",
            "DEPENDENCY_WAITING 1",
            "WAITING WAIT-1: Task waiting on unresolved dependency",
            "  dependencies: Missing prerequisite",
            "  unresolved_dependency_ids: MISSING-1",
        ]:
            if expected not in status_result.stdout:
                failures.append(f"status did not report {expected!r} in the dependency integration check")
        return failures


def check_plan_next_skips_duplicate_templates() -> list[str]:
    if os.environ.get("AOS_SKIP_PLAN_NEXT_CHECK") == "1":
        return []

    with tempfile.TemporaryDirectory() as tmp_dir:
        tmp_root = Path(tmp_dir) / "repo"
        shutil.copytree(ROOT, tmp_root, ignore=shutil.ignore_patterns(".git", "__pycache__", "logs"))

        tasks_path = tmp_root / "mission" / "tasks.json"
        tasks_data = {
            "version": 1,
            "updated_at": "2026-05-31T00:00:00Z",
            "tasks": [
                {
                    "id": "AUTO-1",
                    "title": "Already planned work",
                    "theme": "supervisor",
                    "status": "done",
                    "priority": "medium",
                    "kind": "improvement",
                    "safe": True,
                    "requires_human_review": False,
                    "done_condition": "Already completed planner work.",
                    "completed_at": "2026-05-31T00:00:00Z",
                    "completion_summary": "Already completed.",
                },
                {
                    "id": "RISK-ONLY",
                    "title": "Only blocked risk remains",
                    "status": "pending",
                    "priority": "medium",
                    "kind": "risk",
                    "safe": False,
                    "requires_human_review": True,
                    "blocked_by_human": True,
                    "done_condition": "Remain blocked.",
                    "blocker_reason": "Still waiting for human approval.",
                },
            ],
        }
        tasks_path.write_text(json.dumps(tasks_data, indent=2) + "\n")

        execution_log_path = tmp_root / "mission" / "execution-log.ndjson"
        execution_log_path.write_text("")

        plan_next_path = tmp_root / "scripts" / "plan-next"
        plan_next_path.chmod(plan_next_path.stat().st_mode | stat.S_IXUSR)

        env = os.environ.copy()
        env["AOS_SKIP_PLAN_NEXT_CHECK"] = "1"
        env["AOS_MAX_AUTO_TASKS"] = "1"

        result = subprocess.run(
            [str(plan_next_path)],
            cwd=tmp_root,
            capture_output=True,
            text=True,
            env=env,
        )

        if result.returncode != 0:
            return [f"plan-next did not skip duplicates cleanly in integration check: {result.stdout.strip()} {result.stderr.strip()}".strip()]

        if "PLANNING_SKIPPED" not in result.stdout or "budget" not in result.stdout:
            return ["plan-next did not explain that planning stopped because the auto task budget was exhausted"]

        updated_tasks = json.loads(tasks_path.read_text())
        auto_tasks = [task for task in updated_tasks.get("tasks", []) if task.get("id", "").startswith("AUTO-")]
        if len(auto_tasks) != 1:
            return ["plan-next created additional AUTO-* tasks even though the auto task budget was already exhausted"]

        events = [json.loads(line) for line in execution_log_path.read_text().splitlines() if line.strip()]
        if any(event.get("event") == "planned_next_tasks" for event in events):
            return ["plan-next logged planned_next_tasks even though the auto task budget was already exhausted"]

    return []


