        bin_dir.mkdir()
        counter_path = Path(tmp_dir) / "opencode-count"

        opencode_path = bin_dir / "opencode"
        opencode_path.write_text(
            "#!/bin/sh\n"
            f"COUNT_FILE=\"{counter_path}\"\n"
            "count=0\n"
            "if [ -f \"$COUNT_FILE\" ]; then\n"
            "  count=$(cat \"$COUNT_FILE\")\n"
            "fi\n"
            "count=$((count + 1))\n"
            "printf '%s' \"$count\" > \"$COUNT_FILE\"\n"
            "if [ \"$count\" -eq 1 ]; then\n"
            "  printf 'BLOCKED_BY_HUMAN: Need a human decision before continuing this slice.\\n'\n"
            "elif [ \"$count\" -eq 2 ]; then\n"
            "  printf 'COMPLETION_SUMMARY: Completed the next safe task after recording the blocker.\\n'\n"
            "else\n"
            "  printf 'BLOCKED_BY_HUMAN: Another task now needs human input, so only blocked work should remain.\\n'\n"
            "fi\n"
        )
        opencode_path.chmod(opencode_path.stat().st_mode | stat.S_IXUSR)

        git_path = bin_dir / "git"
        git_path.write_text("#!/bin/sh\nexit 0\n")
        git_path.chmod(git_path.stat().st_mode | stat.S_IXUSR)

        env = os.environ.copy()
        env["PATH"] = f"{bin_dir}{os.pathsep}{env.get('PATH', '')}"
        env["MAX_ITERATIONS"] = "10"
        env["AOS_SKIP_EPISODE_BEHAVIOR_CHECK"] = "1"
        env["AOS_SKIP_SUPERVISOR_CHECK"] = "1"
        env["AOS_MAX_AUTO_TASKS"] = "3"

        result = subprocess.run(
            [str(tmp_root / "scripts" / "episode")],
            cwd=tmp_root,
            capture_output=True,
            text=True,
            env=env,
        )

        if result.returncode != 0:
            return [
                "episode did not continue cleanly past a blocked task in the integration check: "
                f"stdout={result.stdout.strip()} stderr={result.stderr.strip()}"
            ]

        if "Task blocked by human input request. Continuing to the next iteration." not in result.stdout:
            failures.append("episode did not report continuing after a blocked task")

        agent_invocations = int(counter_path.read_text().strip())
        if agent_invocations < 2 or agent_invocations > 5:
            failures.append("episode did not keep invoking the agent through blocker, completion, and planner-generated follow-up work")

        updated_tasks = json.loads(tasks_path.read_text())
        first_task = next(task for task in updated_tasks["tasks"] if task["id"] == "NEXT-1")
        second_task = next(task for task in updated_tasks["tasks"] if task["id"] == "NEXT-2")

        if not first_task.get("blocked_by_human", False) or first_task.get("status") != "pending":
            failures.append("episode did not leave the blocked task pending with blocked_by_human=true")

        if second_task.get("status") != "done":
            failures.append("episode did not complete the later safe task after the blocker")

        if not second_task.get("completion_summary"):
            failures.append("episode did not record completion evidence for the later safe task")

        auto_tasks = [task for task in updated_tasks["tasks"] if task["id"].startswith("AUTO-")]
        if not auto_tasks or len(auto_tasks) > 3:
            failures.append("episode did not preserve the planner-generated task budget in the continuation check")

        events = [json.loads(line) for line in execution_log_path.read_text().splitlines() if line.strip()]
        if not any(event.get("event") == "blocked_by_human" and event.get("task_id") == "NEXT-1" for event in events):
            failures.append("episode did not log the blocked task event during continuation")

        if not any(event.get("event") == "completed" and event.get("task_id") == "NEXT-2" for event in events):
            failures.append("episode did not log completion for the later safe task")

    return failures


def check_supervisor_loop() -> list[str]:
    supervisor_text = (ROOT / "scripts" / "supervisor").read_text()

    failures = []
    if "AFK" not in supervisor_text:
        failures.append("supervisor must launch bounded AFK episodes")
    if "SUPERVISOR_IDLE_BLOCKED" not in supervisor_text:
        failures.append("supervisor must report clean idle-blocked state")
    if "AOS_SUPERVISOR_POLL_SECONDS" not in supervisor_text:
        failures.append("supervisor must support a configurable poll interval")
    if "SUPERVISOR_CYCLE_SUMMARY" not in supervisor_text:
        failures.append("supervisor must emit structured per-cycle summaries")
    if "supervisor_cycle_summary" not in supervisor_text:
        failures.append("supervisor must log supervisor_cycle_summary events")
    if "attention_required" not in supervisor_text:
        failures.append("supervisor cycle summaries must surface the current attention_required signal")
    if "suggested_action" not in supervisor_text:
        failures.append("supervisor cycle summaries must surface the next suggested operator action")
    if "next_step" not in supervisor_text:
        failures.append("supervisor cycle summaries must surface the combined next-step operator hint")
    if "suggested_action_task" not in supervisor_text:
        failures.append("supervisor cycle summaries must surface the concrete task targeted by the suggested action when one exists")
    if "repo_state" not in supervisor_text:
        failures.append("supervisor cycle summaries must surface the repo state after each cycle")
    if "repo_state_reason" not in supervisor_text:
        failures.append("supervisor cycle summaries must explain why that repo state applies")
    if "status_posture" not in supervisor_text:
        failures.append("supervisor cycle summaries must surface the shared status_posture signal")
    if "queue_health" not in supervisor_text:
        failures.append("supervisor cycle summaries must surface the shared queue_health signal")
    if "human_input_queue" not in supervisor_text:
        failures.append("supervisor cycle summaries must surface the shared human_input_queue signal")
    if "waiting_on_task" not in supervisor_text:
        failures.append("supervisor cycle summaries must surface the concrete waiting_on task when one exists")
    if "executable_safe_tasks" not in supervisor_text:
        failures.append("supervisor cycle summaries must surface how many safe tasks remain executable after each cycle")
    if "completed_task_ids" not in supervisor_text:
        failures.append("supervisor cycle summaries must surface which tasks finished in the cycle")
    if "next_task_id" not in supervisor_text:
        failures.append("supervisor cycle summaries must surface the next executable task when work remains")
    return failures


def check_supervisor_sleep_resume() -> list[str]:
    if os.environ.get("AOS_SKIP_SUPERVISOR_CHECK") == "1":
        return []

    with tempfile.TemporaryDirectory() as tmp_dir:
        tmp_root = Path(tmp_dir) / "repo"
        shutil.copytree(ROOT, tmp_root, ignore=shutil.ignore_patterns(".git", "__pycache__", "logs"))

        tasks_path = tmp_root / "mission" / "tasks.json"
        tasks_data = {
            "version": 1,
            "updated_at": "2026-05-31T00:00:00Z",
            "tasks": [
                {
                    "id": "DONE-1",
                    "title": "Seed completed task",
                    "status": "done",
                    "priority": "low",
                    "kind": "bootstrap",
                    "safe": True,
                    "requires_human_review": False,
                    "done_condition": "Seed completion evidence exists.",
                    "completed_at": "2026-05-31T00:00:00Z",
                    "completion_summary": "Seed completion evidence.",
                },
                {
                    "id": "BLOCKED-1",
                    "title": "Waiting for human input",
                    "status": "pending",
                    "priority": "medium",
                    "kind": "risk",
                    "safe": True,
                    "requires_human_review": False,
                    "blocked_by_human": True,
                    "blocker_reason": "Need a human decision.",
                    "done_condition": "Remain blocked until a human unblocks it.",
                },
            ],
        }
        tasks_path.write_text(json.dumps(tasks_data, indent=2) + "\n")

        execution_log_path = tmp_root / "mission" / "execution-log.ndjson"
        execution_log_path.write_text(
            json.dumps(
                {
                    "timestamp": "2026-05-31T00:00:00Z",
                    "event": "completed",
                    "task_id": "DONE-1",
                    "title": "Seed completed task",
                    "summary": "Seed completion evidence.",
                }
            )
            + "\n"
        )

        afk_path = tmp_root / "scripts" / "afk"
        afk_counter_path = Path(tmp_dir) / "afk-count"
        afk_path.write_text(
            "#!/bin/sh\n"
            f"COUNT_FILE=\"{afk_counter_path}\"\n"
            "count=0\n"
            "if [ -f \"$COUNT_FILE\" ]; then\n"
            "  count=$(cat \"$COUNT_FILE\")\n"
            "fi\n"
            "count=$((count + 1))\n"
            "printf '%s' \"$count\" > \"$COUNT_FILE\"\n"
            "exit 0\n"
        )
        afk_path.chmod(afk_path.stat().st_mode | stat.S_IXUSR)

        updater_path = Path(tmp_dir) / "release-work.py"
        updater_path.write_text(
            "#!/usr/bin/env python3\n"
            "import json\n"
            "import time\n"
            "from pathlib import Path\n"
            f"tasks_path = Path({str(tasks_path)!r})\n"
            "time.sleep(0.5)\n"
            "data = json.loads(tasks_path.read_text())\n"
            "data['tasks'].append({\n"
            "    'id': 'NEXT-1',\n"
            "    'title': 'Unblocked safe work appears',\n"
            "    'status': 'pending',\n"
            "    'priority': 'high',\n"
            "    'kind': 'improvement',\n"
            "    'safe': True,\n"
            "    'requires_human_review': False,\n"
            "    'done_condition': 'Be picked up by the supervisor once work appears.'\n"
            "})\n"
            "tasks_path.write_text(json.dumps(data, indent=2) + '\\n')\n"
        )
        updater_path.chmod(updater_path.stat().st_mode | stat.S_IXUSR)

        env = os.environ.copy()
        env["AOS_SUPERVISOR_POLL_SECONDS"] = "0.05"
        env["AOS_SUPERVISOR_MAX_CYCLES"] = "1"
        env["AOS_SKIP_SUPERVISOR_CHECK"] = "1"

        updater = subprocess.Popen([sys.executable, str(updater_path)], cwd=tmp_root)
        try:
            result = subprocess.run(
                [str(tmp_root / "scripts" / "supervisor"), "2"],
                cwd=tmp_root,
                capture_output=True,
                text=True,
                env=env,
                timeout=10,
            )
        finally:
            updater.wait(timeout=10)

        failures = []
        if result.returncode != 0:
            failures.append(
                "supervisor did not complete cleanly in the sleep/resume integration check: "
                f"stdout={result.stdout.strip()} stderr={result.stderr.strip()}"
            )
            return failures

        if "SUPERVISOR_IDLE_BLOCKED" not in result.stdout:
            failures.append("supervisor did not report entering clean idle-blocked state before sleeping")

        if "SUPERVISOR_LAUNCH cycle=1 episode_iterations=2" not in result.stdout:
            failures.append("supervisor did not resume and launch an AFK episode when safe work appeared")

        if not afk_counter_path.exists() or afk_counter_path.read_text().strip() != "1":
            failures.append("supervisor did not launch exactly one AFK episode after waking up")

    return failures


def check_supervisor_cycle_summary() -> list[str]:
    if os.environ.get("AOS_SKIP_SUPERVISOR_CHECK") == "1":
        return []

    with tempfile.TemporaryDirectory() as tmp_dir:
        tmp_root = Path(tmp_dir) / "repo"
        shutil.copytree(ROOT, tmp_root, ignore=shutil.ignore_patterns(".git", "__pycache__", "logs"))

        tasks_path = tmp_root / "mission" / "tasks.json"
        tasks_data = {
            "version": 1,
            "updated_at": "2026-05-31T00:00:00Z",
            "tasks": [
                {
                    "id": "AUTO-7",
                    "title": "Add supervisor cycle outcome summaries",
                    "status": "pending",
                    "priority": "high",
                    "kind": "improvement",
                    "safe": True,
                    "requires_human_review": False,
                    "done_condition": "Be completed by the AFK stub.",
                },
                {
                    "id": "BLOCKED-1",
                    "title": "Waiting for human input",
                    "status": "pending",
                    "priority": "medium",
                    "kind": "risk",
                    "safe": True,
                    "requires_human_review": False,
                    "blocked_by_human": True,
                    "blocker_reason": "Need a human decision.",
                    "done_condition": "Remain blocked until a human unblocks it.",
                },
            ],
        }
        tasks_path.write_text(json.dumps(tasks_data, indent=2) + "\n")

        execution_log_path = tmp_root / "mission" / "execution-log.ndjson"
        execution_log_path.write_text("")

        afk_path = tmp_root / "scripts" / "afk"
        afk_path.write_text(
            "#!/usr/bin/env python3\n"
            "import json\n"
            "import sys\n"
            "from pathlib import Path\n"
            "root = Path(__file__).resolve().parent.parent\n"
            "tasks_path = root / 'mission' / 'tasks.json'\n"
            "data = json.loads(tasks_path.read_text())\n"
            "for task in data['tasks']:\n"
            "    if task['id'] == 'AUTO-7':\n"
            "        task['status'] = 'done'\n"
            "        task['completed_at'] = '2026-05-31T00:00:00Z'\n"
            "        task['completion_summary'] = 'AFK stub completed the task.'\n"
            "tasks_path.write_text(json.dumps(data, indent=2) + '\\n')\n"
            "sys.exit(0)\n"
        )
        afk_path.chmod(afk_path.stat().st_mode | stat.S_IXUSR)

        env = os.environ.copy()
        env["AOS_SUPERVISOR_MAX_CYCLES"] = "1"
        env["AOS_SKIP_SUPERVISOR_CHECK"] = "1"

        result = subprocess.run(
            [str(tmp_root / "scripts" / "supervisor"), "3"],
            cwd=tmp_root,
            capture_output=True,
            text=True,
            env=env,
            timeout=10,
        )

        failures = []
        if result.returncode != 0:
            failures.append(
                "supervisor did not complete cleanly in the cycle-summary integration check: "
                f"stdout={result.stdout.strip()} stderr={result.stderr.strip()}"
            )
            return failures

        summary_line = (
            "SUPERVISOR_CYCLE_SUMMARY cycle=1 outcome=clean_idle repo_state=clean_idle_blocked repo_state_reason=human_blocked_only status_posture=clean_idle_blocked queue_health=blocked_only human_input_queue='review=0 blocked=1 total=1' attention_required=unblock suggested_action=unblock_human_task next_step='unblock_human_task BLOCKED-1: Waiting for human input' waiting_on=human_unblock waiting_on_task_id=BLOCKED-1 waiting_on_task_title='Waiting for human input' afk_exit_status=0 "
            "completed_count=1 completed_task_ids=AUTO-7 completed_task_titles='Add supervisor cycle outcome summaries' "
            "suggested_action_task_id=BLOCKED-1 suggested_action_task_title='Waiting for human input' remaining_safe_tasks=0 executable_safe_tasks=0"
        )
        if summary_line not in result.stdout:
            failures.append("supervisor did not print the expected clean-idle cycle summary after a successful AFK cycle")

        events = [json.loads(line) for line in execution_log_path.read_text().splitlines() if line.strip()]
        summary_events = [event for event in events if event.get("event") == "supervisor_cycle_summary"]
        if len(summary_events) != 1:
            failures.append("supervisor did not append exactly one supervisor_cycle_summary event in the cycle-summary integration check")
        else:
            event = summary_events[0]
            if event.get("cycle") != 1 or event.get("outcome") != "clean_idle" or event.get("afk_exit_status") != 0:
                failures.append("supervisor_cycle_summary event did not record the expected cycle, clean-idle outcome, and afk exit status")
            if event.get("attention_required") != "unblock":
                failures.append("supervisor_cycle_summary event did not record the expected attention_required signal for the clean-idle cycle")
            if event.get("repo_state") != "clean_idle_blocked":
                failures.append("supervisor_cycle_summary event did not record the expected repo state for the clean-idle cycle")
            if event.get("repo_state_reason") != "human_blocked_only":
                failures.append("supervisor_cycle_summary event did not record the expected repo state reason for the clean-idle cycle")
            if event.get("status_posture") != "clean_idle_blocked":
                failures.append("supervisor_cycle_summary event did not record the expected status posture for the clean-idle cycle")
            if event.get("queue_health") != "blocked_only":
                failures.append("supervisor_cycle_summary event did not record the expected queue health for the clean-idle cycle")
            if event.get("human_input_queue") != "review=0 blocked=1 total=1":
                failures.append("supervisor_cycle_summary event did not record the expected human_input_queue signal for the clean-idle cycle")
            if event.get("suggested_action") != "unblock_human_task":
                failures.append("supervisor_cycle_summary event did not record the expected suggested action for the clean-idle cycle")
            if event.get("next_step") != "unblock_human_task BLOCKED-1: Waiting for human input":
                failures.append("supervisor_cycle_summary event did not record the expected next_step signal for the clean-idle cycle")
            if event.get("waiting_on") != "human_unblock":
                failures.append("supervisor_cycle_summary event did not record the expected waiting_on signal for the clean-idle cycle")
            if event.get("waiting_on_task_id") != "BLOCKED-1":
                failures.append("supervisor_cycle_summary event did not record the expected waiting_on task id for the clean-idle cycle")
            if event.get("waiting_on_task_title") != "Waiting for human input":
                failures.append("supervisor_cycle_summary event did not record the expected waiting_on task title for the clean-idle cycle")
            if event.get("completed_task_ids") != ["AUTO-7"]:
                failures.append("supervisor_cycle_summary event did not record the expected completed task ids for the clean-idle cycle")
            if event.get("completed_task_titles") != ["Add supervisor cycle outcome summaries"]:
                failures.append("supervisor_cycle_summary event did not record the expected completed task titles for the clean-idle cycle")
            if event.get("suggested_action_task_id") != "BLOCKED-1":
                failures.append("supervisor_cycle_summary event did not record the expected suggested action task id for the clean-idle cycle")
            if event.get("suggested_action_task_title") != "Waiting for human input":
                failures.append("supervisor_cycle_summary event did not record the expected suggested action task title for the clean-idle cycle")
            if event.get("remaining_safe_tasks") != 0:
                failures.append("supervisor_cycle_summary event did not record the expected remaining safe task count for the clean-idle cycle")
            if event.get("executable_safe_tasks") != 0:
                failures.append("supervisor_cycle_summary event did not record the expected executable safe task count for the clean-idle cycle")

    return failures


def check_supervisor_cycle_next_task_summary() -> list[str]:
    if os.environ.get("AOS_SKIP_SUPERVISOR_CHECK") == "1":
        return []

    with tempfile.TemporaryDirectory() as tmp_dir:
        tmp_root = Path(tmp_dir) / "repo"
        shutil.copytree(ROOT, tmp_root, ignore=shutil.ignore_patterns(".git", "__pycache__", "logs"))

        tasks_path = tmp_root / "mission" / "tasks.json"
        tasks_data = {
            "version": 1,
            "updated_at": "2026-05-31T00:00:00Z",
            "tasks": [
                {
                    "id": "AUTO-13",
                    "title": "Finish first task",
                    "status": "pending",
                    "priority": "high",
                    "kind": "improvement",
                    "safe": True,
                    "requires_human_review": False,
                    "done_condition": "Be completed by the AFK stub.",
                },
                {
                    "id": "AUTO-14",
                    "title": "Second queued task",
                    "status": "pending",
                    "priority": "medium",
                    "kind": "improvement",
                    "safe": True,
                    "requires_human_review": False,
                    "done_condition": "Remain queued after the first task completes.",
                },
            ],
        }
        tasks_path.write_text(json.dumps(tasks_data, indent=2) + "\n")

        execution_log_path = tmp_root / "mission" / "execution-log.ndjson"
        execution_log_path.write_text("")

        afk_path = tmp_root / "scripts" / "afk"
        afk_path.write_text(
            "#!/usr/bin/env python3\n"
            "import json\n"
            "import sys\n"
            "from pathlib import Path\n"
            "root = Path(__file__).resolve().parent.parent\n"
            "tasks_path = root / 'mission' / 'tasks.json'\n"
            "data = json.loads(tasks_path.read_text())\n"
            "for task in data['tasks']:\n"
            "    if task['id'] == 'AUTO-13':\n"
            "        task['status'] = 'done'\n"
            "        task['completed_at'] = '2026-05-31T00:00:00Z'\n"
            "        task['completion_summary'] = 'AFK stub completed the first task.'\n"
            "tasks_path.write_text(json.dumps(data, indent=2) + '\\n')\n"
            "sys.exit(0)\n"
        )
        afk_path.chmod(afk_path.stat().st_mode | stat.S_IXUSR)

        env = os.environ.copy()
        env["AOS_SUPERVISOR_MAX_CYCLES"] = "1"
        env["AOS_SKIP_SUPERVISOR_CHECK"] = "1"

        result = subprocess.run(
            [str(tmp_root / "scripts" / "supervisor"), "3"],
            cwd=tmp_root,
            capture_output=True,
            text=True,
            env=env,
            timeout=10,
        )

        failures = []
        if result.returncode != 0:
            failures.append(
                "supervisor did not complete cleanly in the next-task summary integration check: "
                f"stdout={result.stdout.strip()} stderr={result.stderr.strip()}"
            )
            return failures

        expected_line = (
            "SUPERVISOR_CYCLE_SUMMARY cycle=1 outcome=progress repo_state=planned repo_state_reason=ready_safe_backlog status_posture=ready_safe_backlog queue_health=ready_backlog human_input_queue='review=0 blocked=0 total=0' attention_required=none suggested_action=execute_next_safe_task next_step='execute_next_safe_task AUTO-14: Second queued task' waiting_on=none afk_exit_status=0 "
            "completed_count=1 completed_task_ids=AUTO-13 completed_task_titles='Finish first task' next_task_id=AUTO-14 "
            "next_task_title='Second queued task' suggested_action_task_id=AUTO-14 suggested_action_task_title='Second queued task' remaining_safe_tasks=1 executable_safe_tasks=1"
        )
        if expected_line not in result.stdout:
            failures.append("supervisor did not print the expected next-task cycle summary after making progress")

        events = [json.loads(line) for line in execution_log_path.read_text().splitlines() if line.strip()]
        summary_events = [event for event in events if event.get("event") == "supervisor_cycle_summary"]
        if len(summary_events) != 1:
            failures.append("supervisor did not append exactly one supervisor_cycle_summary event in the next-task summary integration check")
        else:
            event = summary_events[0]
            if event.get("outcome") != "progress" or event.get("next_task_id") != "AUTO-14":
                failures.append("supervisor_cycle_summary event did not record the expected progress outcome and next task id")
            if event.get("attention_required") != "none":
                failures.append("supervisor_cycle_summary event did not record the expected attention_required signal for the progress cycle")
            if event.get("repo_state") != "planned":
                failures.append("supervisor_cycle_summary event did not record the expected repo state for the progress cycle")
            if event.get("repo_state_reason") != "ready_safe_backlog":
                failures.append("supervisor_cycle_summary event did not record the expected repo state reason for the progress cycle")
            if event.get("status_posture") != "ready_safe_backlog":
                failures.append("supervisor_cycle_summary event did not record the expected status posture for the progress cycle")
            if event.get("queue_health") != "ready_backlog":
                failures.append("supervisor_cycle_summary event did not record the expected queue health for the progress cycle")
            if event.get("human_input_queue") != "review=0 blocked=0 total=0":
                failures.append("supervisor_cycle_summary event did not record the expected human_input_queue signal for the progress cycle")
            if event.get("suggested_action") != "execute_next_safe_task":
                failures.append("supervisor_cycle_summary event did not record the expected suggested action for the progress cycle")
            if event.get("next_step") != "execute_next_safe_task AUTO-14: Second queued task":
                failures.append("supervisor_cycle_summary event did not record the expected next_step signal for the progress cycle")
            if event.get("waiting_on") != "none":
                failures.append("supervisor_cycle_summary event did not record the expected waiting_on signal for the progress cycle")
            if "waiting_on_task_id" in event or "waiting_on_task_title" in event:
                failures.append("supervisor_cycle_summary event should omit waiting_on task details when no waiting_on task exists in the progress cycle")
            if event.get("completed_task_ids") != ["AUTO-13"]:
                failures.append("supervisor_cycle_summary event did not record the expected completed task ids for the progress cycle")
            if event.get("completed_task_titles") != ["Finish first task"]:
                failures.append("supervisor_cycle_summary event did not record the expected completed task titles for the progress cycle")
            if event.get("next_task_title") != "Second queued task":
                failures.append("supervisor_cycle_summary event did not record the expected next task title")
            if event.get("suggested_action_task_id") != "AUTO-14":
                failures.append("supervisor_cycle_summary event did not record the expected suggested action task id for the progress cycle")
            if event.get("suggested_action_task_title") != "Second queued task":
                failures.append("supervisor_cycle_summary event did not record the expected suggested action task title for the progress cycle")
            if event.get("remaining_safe_tasks") != 1:
                failures.append("supervisor_cycle_summary event did not record the expected remaining safe task count for the progress cycle")
            if event.get("executable_safe_tasks") != 1:
                failures.append("supervisor_cycle_summary event did not record the expected executable safe task count for the progress cycle")

    return failures


def check_afk_log_index() -> list[str]:
    if os.environ.get("AOS_SKIP_AFK_LOG_INDEX_CHECK") == "1":
        return []

    with tempfile.TemporaryDirectory() as tmp_dir:
        tmp_root = Path(tmp_dir) / "repo"
        shutil.copytree(ROOT, tmp_root, ignore=shutil.ignore_patterns(".git", "__pycache__", "logs"))

        logs_dir = tmp_root / "logs"
        logs_dir.mkdir(parents=True, exist_ok=True)
        (logs_dir / "afk-20260531-100000.log").write_text(
            "TASK_STARTED\n"
            "task_id: AUTO-0\n"
            "title: Older failed task\n"
            "Traceback (most recent call last):\n"
        )
        (logs_dir / "afk-20260531-110000.log").write_text(
            "TASK_STARTED\n"
            "task_id: AUTO-1\n"
            "title: Waiting task\n"
            "BLOCKED_BY_HUMAN: Need input before continuing.\n"
        )
        (logs_dir / "afk-20260531-120000.log").write_text(
            "TASK_STARTED\n"
            "task_id: AUTO-2\n"
            "title: Completed task\n"
            "COMPLETION_SUMMARY: Added the missing log index command.\n"
        )

        result = subprocess.run(
            [str(tmp_root / "scripts" / "afk-log-index"), "2"],
            cwd=tmp_root,
            capture_output=True,
            text=True,
            env={**os.environ, "AOS_SKIP_AFK_LOG_INDEX_CHECK": "1"},
        )

        if result.returncode != 0:
            return [f"afk-log-index failed in integration check: {result.stdout.strip()} {result.stderr.strip()}".strip()]

        failures = []
        for expected in [
            "AFK_LOGS 2",
            "2026-05-31T12:00:00Z progress afk-20260531-120000.log",
            "  last_task_id: AUTO-2",
            "  last_task_title: Completed task",
            "  evidence: COMPLETION_SUMMARY: Added the missing log index command.",
            "2026-05-31T11:00:00Z blocked afk-20260531-110000.log",
            "  last_task_id: AUTO-1",
            "  last_task_title: Waiting task",
            "  evidence: BLOCKED_BY_HUMAN: Need input before continuing.",
        ]:
            if expected not in result.stdout:
                failures.append(f"afk-log-index did not report {expected!r} in the integration check")
        if "afk-20260531-100000.log" in result.stdout:
            failures.append("afk-log-index did not respect the requested result limit")
        return failures


def main() -> int:
    failures = []
    failures.extend(check_files())
    failures.extend(check_tasks())
    failures.extend(check_next_task())
    failures.extend(check_execute_task())
    failures.extend(check_execution_log())
    failures.extend(check_completion_helper())
    failures.extend(check_plan())
    failures.extend(check_review_gate())
    failures.extend(check_blocker_model())
    failures.extend(check_dependency_metadata())
    failures.extend(check_status_summary_modes())
    failures.extend(check_status_last_plan_summary())
    failures.extend(check_status_stale_work_indicators())
    failures.extend(check_dependency_aware_selection())
    failures.extend(check_blocker_commands())
    failures.extend(check_planning_loop())
    failures.extend(check_plan_next_generates_tasks())
    failures.extend(check_plan_next_skips_duplicate_templates())
    failures.extend(check_planner_candidates_budget_exhausted_explanation())
    failures.extend(check_plan_next_generates_follow_up_batches())
    failures.extend(check_plan_next_progresses_beyond_initial_templates())
    failures.extend(check_plan_next_limits_theme_breadth())
    failures.extend(check_planner_candidate_audit_command())
    failures.extend(check_planner_candidate_theme_limit_explanations())
    failures.extend(check_planner_candidate_batch_limit_explanations())
    failures.extend(check_episode_completion_loop())
    failures.extend(check_episode_blocker_continuation())
    failures.extend(check_supervisor_loop())
    failures.extend(check_supervisor_sleep_resume())
    failures.extend(check_supervisor_cycle_summary())
    failures.extend(check_supervisor_cycle_next_task_summary())
    failures.extend(check_afk_log_index())

    if failures:
        print("EVAL_FAIL")
        for failure in failures:
            print(f"- {failure}")
        return 1

    print("EVAL_PASS")
    print("bootstrap repository capabilities are present")
    return 0


if __name__ == "__main__":
    sys.exit(main())
