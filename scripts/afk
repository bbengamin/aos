#!/bin/bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "$0")/.." && pwd)"

if [ -z "${1:-}" ]; then
  printf 'Usage: %s <iterations>\n' "$0"
  exit 1
fi

ITERATIONS="$1"
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"
LOG_DIR="$ROOT_DIR/logs"
LOG_FILE="$LOG_DIR/afk-$TIMESTAMP.log"

mkdir -p "$LOG_DIR"

printf 'Starting AFK episode: iterations=%s log=%s\n' "$ITERATIONS" "$LOG_FILE"

(
  cd "$ROOT_DIR"
  env MAX_ITERATIONS="$ITERATIONS" ./scripts/episode
) 2>&1 | tee "$LOG_FILE"

STATUS=${PIPESTATUS[0]}

case "$STATUS" in
  0)
    printf 'AFK episode finished successfully.\n'
    ;;
  2)
    printf 'AFK episode stopped for human review.\n'
    ;;
  *)
    printf 'AFK episode exited with status %s.\n' "$STATUS"
    ;;
esac

printf 'Log saved to %s\n' "$LOG_FILE"
exit "$STATUS"
