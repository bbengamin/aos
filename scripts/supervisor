#!/usr/bin/env python3

import os
import subprocess
import sys
import time
from pathlib import Path

from tasklib import (
    attention_required,
    append_execution_event,
    blocked_tasks,
    current_in_progress_task,
    dependency_waiting_tasks,
    has_executable_safe_task,
    is_clean_idle_blocked,
    load_tasks,
    next_action,
    next_action_task,
    next_safe_task,
    overall_state,
    pending_safe_tasks,
    queue_health,
    review_waiting_tasks,
    state_reason,
    utc_now,
)


ROOT = Path(__file__).resolve().parent.parent
AFK = ROOT / "scripts" / "afk"


def record_cycle_outcome(
    *,
    cycle: int,
    episode_iterations: str,
    outcome: str,
    repo_state: str,
    repo_state_reason: str,
    queue_health_state: str,
    attention: str,
    suggested_action: str,
    afk_exit_status: int | None = None,
    completed_tasks: list[dict] | None = None,
    next_task: dict | None = None,
    suggested_action_task: dict | None = None,
    remaining_safe_tasks: int | None = None,
) -> None:
    event = {
        "timestamp": utc_now(),
        "event": "supervisor_cycle_summary",
        "cycle": cycle,
        "episode_iterations": str(episode_iterations),
        "outcome": outcome,
        "repo_state": repo_state,
        "repo_state_reason": repo_state_reason,
        "queue_health": queue_health_state,
        "attention_required": attention,
        "suggested_action": suggested_action,
    }
    if afk_exit_status is not None:
        event["afk_exit_status"] = afk_exit_status
    if completed_tasks:
        event["completed_task_ids"] = [task.get("id") for task in completed_tasks if task.get("id")]
        event["completed_task_titles"] = [task.get("title") for task in completed_tasks if task.get("title")]
    if next_task is not None:
        event["next_task_id"] = next_task.get("id")
        event["next_task_title"] = next_task.get("title")
    if suggested_action_task is not None:
        event["suggested_action_task_id"] = suggested_action_task.get("id")
        event["suggested_action_task_title"] = suggested_action_task.get("title")
    if remaining_safe_tasks is not None:
        event["remaining_safe_tasks"] = remaining_safe_tasks
    append_execution_event(event)

    parts = [
        f"SUPERVISOR_CYCLE_SUMMARY cycle={cycle} outcome={outcome} repo_state={repo_state} repo_state_reason={repo_state_reason} queue_health={queue_health_state} attention_required={attention} suggested_action={suggested_action}"
    ]
    if afk_exit_status is not None:
        parts.append(f"afk_exit_status={afk_exit_status}")
    if completed_tasks:
        parts.append(f"completed_count={len(completed_tasks)}")
        parts.append(f"completed_task_ids={','.join(task.get('id') for task in completed_tasks if task.get('id'))}")
        completed_titles = [task.get("title") for task in completed_tasks if task.get("title")]
        if completed_titles:
            parts.append(f"completed_task_titles={','.join(completed_titles)!r}")
    if next_task is not None:
        parts.append(f"next_task_id={next_task.get('id')}")
        if next_task.get("title"):
            parts.append(f"next_task_title={next_task.get('title')!r}")
    if suggested_action_task is not None:
        parts.append(f"suggested_action_task_id={suggested_action_task.get('id')}")
        if suggested_action_task.get("title"):
            parts.append(f"suggested_action_task_title={suggested_action_task.get('title')!r}")
    if remaining_safe_tasks is not None:
        parts.append(f"remaining_safe_tasks={remaining_safe_tasks}")
    print(" ".join(parts))


def completed_tasks_during_cycle(pre_cycle_data: dict, post_cycle_data: dict) -> list[dict]:
    pre_cycle_done_ids = {
        task.get("id")
        for task in pre_cycle_data.get("tasks", [])
        if task.get("status") == "done" and task.get("id")
    }
    completed = [
        task
        for task in post_cycle_data.get("tasks", [])
        if task.get("status") == "done" and task.get("id") not in pre_cycle_done_ids
    ]
    completed.sort(key=lambda task: task.get("completed_at", ""))
    return completed


def run_afk(iterations: str) -> int:
    result = subprocess.run([str(AFK), iterations], cwd=ROOT)
    return result.returncode


def main() -> int:
    episode_iterations = sys.argv[1] if len(sys.argv) > 1 else os.environ.get("AOS_EPISODE_ITERATIONS", "20")
    poll_seconds = float(os.environ.get("AOS_SUPERVISOR_POLL_SECONDS", "30"))
    max_cycles = int(os.environ.get("AOS_SUPERVISOR_MAX_CYCLES", "0"))
    launched_cycles = 0

    while True:
        data = load_tasks()

        if has_executable_safe_task(data):
            pre_cycle_data = data
            pre_cycle_attention = attention_required(pre_cycle_data)
            pre_cycle_current = current_in_progress_task(pre_cycle_data)
            pre_cycle_next_task = next_safe_task(pre_cycle_data)
            pre_cycle_dependency_waiting = dependency_waiting_tasks(pre_cycle_data)
            pre_cycle_review_waiting = review_waiting_tasks(pre_cycle_data)
            pre_cycle_blockers = blocked_tasks(pre_cycle_data)
            pre_cycle_planned = pending_safe_tasks(pre_cycle_data)
            pre_cycle_clean_idle = is_clean_idle_blocked(pre_cycle_data)
            pre_cycle_suggested_action = next_action(
                attention=pre_cycle_attention,
                current=pre_cycle_current,
                next_task=pre_cycle_next_task,
                dependency_waiting=pre_cycle_dependency_waiting,
            )
            pre_cycle_suggested_action_task = next_action_task(
                attention=pre_cycle_attention,
                current=pre_cycle_current,
                next_task=pre_cycle_next_task,
                dependency_waiting=pre_cycle_dependency_waiting,
                review_waiting=pre_cycle_review_waiting,
                blockers=pre_cycle_blockers,
            )
            if max_cycles and launched_cycles >= max_cycles:
                print("SUPERVISOR_STOPPED")
                print("reason: reached configured cycle limit")
                return 0

            launched_cycles += 1
            print(f"SUPERVISOR_LAUNCH cycle={launched_cycles} episode_iterations={episode_iterations}")
            status = run_afk(episode_iterations)
            if status != 0:
                record_cycle_outcome(
                    cycle=launched_cycles,
                    episode_iterations=episode_iterations,
                    outcome="failure",
                    repo_state=overall_state(
                        current=pre_cycle_current,
                        planned=pre_cycle_planned,
                        blockers=pre_cycle_blockers,
                        dependency_waiting=pre_cycle_dependency_waiting,
                        clean_idle=pre_cycle_clean_idle,
                    ),
                    repo_state_reason=state_reason(
                        current=pre_cycle_current,
                        next_task=pre_cycle_next_task,
                        blockers=pre_cycle_blockers,
                        review_waiting=pre_cycle_review_waiting,
                        dependency_waiting=pre_cycle_dependency_waiting,
                        clean_idle=pre_cycle_clean_idle,
                        attention=pre_cycle_attention,
                    ),
                    queue_health_state=queue_health(
                        current=pre_cycle_current,
                        planned=pre_cycle_planned,
                        blockers=pre_cycle_blockers,
                        review_waiting=pre_cycle_review_waiting,
                        dependency_waiting=pre_cycle_dependency_waiting,
                    ),
                    attention=pre_cycle_attention,
                    suggested_action=pre_cycle_suggested_action,
                    afk_exit_status=status,
                    suggested_action_task=pre_cycle_suggested_action_task,
                )
                print(f"SUPERVISOR_FAILED afk_exit_status={status}")
                return status

            post_cycle_data = load_tasks()
            cycle_outcome = "clean_idle" if is_clean_idle_blocked(post_cycle_data) else "progress"
            completed_tasks = completed_tasks_during_cycle(pre_cycle_data, post_cycle_data)
            next_task = next_safe_task(post_cycle_data) if cycle_outcome == "progress" else None
            remaining_safe_tasks = len(pending_safe_tasks(post_cycle_data))
            post_cycle_attention = attention_required(post_cycle_data)
            post_cycle_current = current_in_progress_task(post_cycle_data)
            post_cycle_dependency_waiting = dependency_waiting_tasks(post_cycle_data)
            post_cycle_review_waiting = review_waiting_tasks(post_cycle_data)
            post_cycle_blockers = blocked_tasks(post_cycle_data)
            post_cycle_planned = pending_safe_tasks(post_cycle_data)
            post_cycle_clean_idle = is_clean_idle_blocked(post_cycle_data)
            post_cycle_suggested_action = next_action(
                attention=post_cycle_attention,
                current=post_cycle_current,
                next_task=next_task,
                dependency_waiting=post_cycle_dependency_waiting,
            )
            record_cycle_outcome(
                cycle=launched_cycles,
                episode_iterations=episode_iterations,
                outcome=cycle_outcome,
                repo_state=overall_state(
                    current=post_cycle_current,
                    planned=post_cycle_planned,
                    blockers=post_cycle_blockers,
                    dependency_waiting=post_cycle_dependency_waiting,
                    clean_idle=post_cycle_clean_idle,
                ),
                repo_state_reason=state_reason(
                    current=post_cycle_current,
                    next_task=next_task,
                    blockers=post_cycle_blockers,
                    review_waiting=post_cycle_review_waiting,
                    dependency_waiting=post_cycle_dependency_waiting,
                    clean_idle=post_cycle_clean_idle,
                    attention=post_cycle_attention,
                ),
                queue_health_state=queue_health(
                    current=post_cycle_current,
                    planned=post_cycle_planned,
                    blockers=post_cycle_blockers,
                    review_waiting=post_cycle_review_waiting,
                    dependency_waiting=post_cycle_dependency_waiting,
                ),
                attention=post_cycle_attention,
                suggested_action=post_cycle_suggested_action,
                afk_exit_status=status,
                completed_tasks=completed_tasks,
                next_task=next_task,
                suggested_action_task=next_action_task(
                    attention=post_cycle_attention,
                    current=post_cycle_current,
                    next_task=next_task,
                    dependency_waiting=post_cycle_dependency_waiting,
                    review_waiting=post_cycle_review_waiting,
                    blockers=post_cycle_blockers,
                ),
                remaining_safe_tasks=remaining_safe_tasks,
            )

            if max_cycles and launched_cycles >= max_cycles:
                print("SUPERVISOR_STOPPED")
                print("reason: reached configured cycle limit")
                return 0
            continue

        if is_clean_idle_blocked(data):
            print(f"SUPERVISOR_IDLE_BLOCKED sleep_seconds={poll_seconds}")
            time.sleep(poll_seconds)
            continue

        print("SUPERVISOR_STOPPED")
        print("reason: no executable safe task and no clean idle-blocked state")
        return 0


if __name__ == "__main__":
    sys.exit(main())
