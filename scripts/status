#!/usr/bin/env python3

import sys

from tasklib import (
    age_seconds,
    blocked_tasks,
    current_in_progress_task,
    dependency_titles,
    format_age,
    is_clean_idle_blocked,
    is_long_blocked_task,
    is_stale_in_progress_task,
    latest_planning_event,
    load_tasks,
    next_safe_task,
    pending_safe_tasks,
    task_is_dependency_blocked,
    unresolved_dependency_ids,
)


def print_task(prefix: str, task: dict) -> None:
    print(f"{prefix}{task['id']}: {task['title']}")
    print(f"  status: {task['status']}")
    print(f"  done_condition: {task['done_condition']}")
    if task.get("planning_reason"):
        print(f"  planning_reason: {task['planning_reason']}")
    titles = dependency_titles(task)
    if titles:
        print(f"  dependencies: {', '.join(titles)}")
    if task.get("blocker_reason"):
        print(f"  blocker_reason: {task['blocker_reason']}")
    if task.get("unblock_resolution"):
        print(f"  unblock_resolution: {task['unblock_resolution']}")

    attention = None
    attention_age = None
    if is_stale_in_progress_task(task):
        attention = "stale_in_progress"
        attention_age = format_age(age_seconds(task.get("started_at")))
    elif is_long_blocked_task(task):
        attention = "long_blocked"
        attention_age = format_age(age_seconds(task.get("blocked_at")))

    if attention:
        suffix = f" ({attention_age})" if attention_age else ""
        print(f"  attention: {attention}{suffix}")


def overall_state(*, current: dict | None, planned: list[dict], blockers: list[dict], dependency_waiting: list[dict], clean_idle: bool) -> str:
    if current:
        return "active"
    if clean_idle:
        return "clean_idle_blocked"
    if planned or dependency_waiting:
        return "planned"
    if blockers:
        return "blocked"
    return "idle"


def attention_required(*, current: dict | None, review_waiting: list[dict], blockers: list[dict]) -> str:
    if review_waiting:
        return "review"
    if current and is_stale_in_progress_task(current):
        return "stale"
    if any(is_long_blocked_task(task) for task in blockers):
        return "stale"
    if blockers:
        return "unblock"
    return "none"


def main() -> int:
    data = load_tasks()

    current = current_in_progress_task(data)
    next_task = next_safe_task(data)
    planned = pending_safe_tasks(data)
    blockers = blocked_tasks(data)
    review_waiting = [
        task
        for task in data.get("tasks", [])
        if task.get("status") == "pending" and task.get("requires_human_review", False)
    ]
    dependency_waiting = [
        task
        for task in data.get("tasks", [])
        if task.get("status") == "pending"
        and not task.get("blocked_by_human", False)
        and task_is_dependency_blocked(task, data)
    ]
    clean_idle = is_clean_idle_blocked(data)
    last_plan = latest_planning_event()

    print(
        f"STATE {overall_state(current=current, planned=planned, blockers=blockers, dependency_waiting=dependency_waiting, clean_idle=clean_idle)}"
    )
    print(f"ATTENTION_REQUIRED {attention_required(current=current, review_waiting=review_waiting, blockers=blockers)}")
    print(f"CLEAN_IDLE_BLOCKED {'yes' if clean_idle else 'no'}")

    if current:
        print_task("CURRENT ", current)
    else:
        print("CURRENT none")

    stale_current = current if current and is_stale_in_progress_task(current) else None
    long_blockers = [task for task in blockers if is_long_blocked_task(task)]
    print(f"STALE_IN_PROGRESS {1 if stale_current else 0}")
    if stale_current:
        print(f"STALE CURRENT {stale_current['id']}: {stale_current['title']}")
    print(f"LONG_BLOCKED {len(long_blockers)}")
    for task in long_blockers:
        print(f"STALE BLOCKED {task['id']}: {task['title']}")

    if next_task:
        print_task("NEXT ", next_task)
    else:
        print("NEXT none")

    print(f"PLANNED_WORK {len(planned)}")
    for task in planned:
        print_task("PLANNED ", task)

    if last_plan:
        print(f"LAST_PLAN {last_plan.get('timestamp', 'unknown')}")
        for task_id, title, reason in zip(
            last_plan.get("task_ids", []),
            last_plan.get("titles", []),
            last_plan.get("planning_reasons", []),
        ):
            print(f"LAST_PLANNED {task_id}: {title}")
            print(f"  planning_reason: {reason}")
    else:
        print("LAST_PLAN none")

    if blockers:
        print(f"BLOCKERS {len(blockers)}")
        for task in blockers:
            print_task("BLOCKED ", task)
    else:
        print("BLOCKERS 0")

    print(f"REVIEW_WAITING {len(review_waiting)}")
    for task in review_waiting:
        print_task("REVIEW ", task)

    print(f"DEPENDENCY_WAITING {len(dependency_waiting)}")
    for task in dependency_waiting:
        print_task("WAITING ", task)
        unresolved = unresolved_dependency_ids(task, data)
        if unresolved:
            print(f"  unresolved_dependency_ids: {', '.join(unresolved)}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
