#!/usr/bin/env python3

import sys

from tasklib import (
    attention_required,
    attention_task,
    age_seconds,
    blocked_tasks,
    current_in_progress_task,
    executable_safe_task_count,
    dependency_waiting_tasks,
    dependency_titles,
    format_age,
    human_input_queue,
    is_clean_idle_blocked,
    is_long_blocked_task,
    is_stale_in_progress_task,
    latest_planning_event,
    load_tasks,
    next_action,
    next_action_task,
    next_step_summary,
    next_safe_task,
    overall_state,
    pending_safe_tasks,
    queue_health,
    review_waiting_tasks,
    state_reason,
    task_is_dependency_blocked,
    unresolved_dependency_ids,
    waiting_on,
)


def print_task(prefix: str, task: dict) -> None:
    print(f"{prefix}{task['id']}: {task['title']}")
    print(f"  status: {task['status']}")
    print(f"  done_condition: {task['done_condition']}")
    if task.get("planning_reason"):
        print(f"  planning_reason: {task['planning_reason']}")
    titles = dependency_titles(task)
    if titles:
        print(f"  dependencies: {', '.join(titles)}")
    if task.get("blocker_reason"):
        print(f"  blocker_reason: {task['blocker_reason']}")
    if task.get("unblock_resolution"):
        print(f"  unblock_resolution: {task['unblock_resolution']}")

    attention = None
    attention_age = None
    if is_stale_in_progress_task(task):
        attention = "stale_in_progress"
        attention_age = format_age(age_seconds(task.get("started_at")))
    elif is_long_blocked_task(task):
        attention = "long_blocked"
        attention_age = format_age(age_seconds(task.get("blocked_at")))

    if attention:
        suffix = f" ({attention_age})" if attention_age else ""
        print(f"  attention: {attention}{suffix}")
def work_inventory(
    *,
    current: dict | None,
    planned: list[dict],
    blockers: list[dict],
    review_waiting: list[dict],
    dependency_waiting: list[dict],
) -> str:
    stale_count = (1 if current and is_stale_in_progress_task(current) else 0) + sum(
        1 for task in blockers if is_long_blocked_task(task)
    )
    return (
        "WORK_INVENTORY"
        f" active={1 if current else 0}"
        f" planned={len(planned)}"
        f" review={len(review_waiting)}"
        f" blocked={len(blockers)}"
        f" dependency_waiting={len(dependency_waiting)}"
        f" stale={stale_count}"
    )


def main() -> int:
    data = load_tasks()

    current = current_in_progress_task(data)
    next_task = next_safe_task(data)
    planned = pending_safe_tasks(data)
    blockers = blocked_tasks(data)
    review_waiting = review_waiting_tasks(data)
    dependency_waiting = dependency_waiting_tasks(data)
    clean_idle = is_clean_idle_blocked(data)
    last_plan = latest_planning_event()
    attention = attention_required(data)
    attention_task_item = attention_task(
        attention=attention,
        current=current,
        review_waiting=review_waiting,
        blockers=blockers,
    )
    next_action_task_item = next_action_task(
        attention=attention,
        current=current,
        next_task=next_task,
        dependency_waiting=dependency_waiting,
        review_waiting=review_waiting,
        blockers=blockers,
    )

    print(
        f"STATE {overall_state(current=current, planned=planned, blockers=blockers, dependency_waiting=dependency_waiting, clean_idle=clean_idle)}"
    )
    print(
        f"STATE_REASON {state_reason(current=current, next_task=next_task, blockers=blockers, review_waiting=review_waiting, dependency_waiting=dependency_waiting, clean_idle=clean_idle, attention=attention)}"
    )
    print(
        work_inventory(
            current=current,
            planned=planned,
            blockers=blockers,
            review_waiting=review_waiting,
            dependency_waiting=dependency_waiting,
        )
    )
    print(
        f"QUEUE_HEALTH {queue_health(current=current, planned=planned, blockers=blockers, review_waiting=review_waiting, dependency_waiting=dependency_waiting)}"
    )
    print(f"HUMAN_INPUT_QUEUE {human_input_queue(review_waiting=review_waiting, blockers=blockers)}")
    print(f"EXECUTABLE_SAFE_TASKS {executable_safe_task_count(data)}")
    print(f"ATTENTION_REQUIRED {attention}")
    print(
        f"NEXT_ACTION {next_action(attention=attention, current=current, next_task=next_task, dependency_waiting=dependency_waiting)}"
    )
    print(
        f"NEXT_STEP {next_step_summary(next_action(attention=attention, current=current, next_task=next_task, dependency_waiting=dependency_waiting), next_action_task_item)}"
    )
    print(
        f"WAITING_ON {waiting_on(review_waiting=review_waiting, blockers=blockers, dependency_waiting=dependency_waiting)}"
    )
    if attention_task_item:
        print(f"ATTENTION_TASK {attention_task_item['id']}: {attention_task_item['title']}")
    else:
        print("ATTENTION_TASK none")
    if next_action_task_item:
        print(f"NEXT_ACTION_TASK {next_action_task_item['id']}: {next_action_task_item['title']}")
    else:
        print("NEXT_ACTION_TASK none")
    print(f"CLEAN_IDLE_BLOCKED {'yes' if clean_idle else 'no'}")

    if current:
        print_task("CURRENT ", current)
    else:
        print("CURRENT none")

    stale_current = current if current and is_stale_in_progress_task(current) else None
    long_blockers = [task for task in blockers if is_long_blocked_task(task)]
    print(f"STALE_IN_PROGRESS {1 if stale_current else 0}")
    if stale_current:
        print(f"STALE CURRENT {stale_current['id']}: {stale_current['title']}")
    print(f"LONG_BLOCKED {len(long_blockers)}")
    for task in long_blockers:
        print(f"STALE BLOCKED {task['id']}: {task['title']}")

    if next_task:
        print_task("NEXT ", next_task)
    else:
        print("NEXT none")

    print(f"PLANNED_WORK {len(planned)}")
    for task in planned:
        print_task("PLANNED ", task)

    if last_plan:
        print(f"LAST_PLAN {last_plan.get('timestamp', 'unknown')}")
        for task_id, title, reason in zip(
            last_plan.get("task_ids", []),
            last_plan.get("titles", []),
            last_plan.get("planning_reasons", []),
        ):
            print(f"LAST_PLANNED {task_id}: {title}")
            print(f"  planning_reason: {reason}")
    else:
        print("LAST_PLAN none")

    if blockers:
        print(f"BLOCKERS {len(blockers)}")
        for task in blockers:
            print_task("BLOCKED ", task)
    else:
        print("BLOCKERS 0")

    print(f"REVIEW_WAITING {len(review_waiting)}")
    for task in review_waiting:
        print_task("REVIEW ", task)

    print(f"DEPENDENCY_WAITING {len(dependency_waiting)}")
    for task in dependency_waiting:
        print_task("WAITING ", task)
        unresolved = unresolved_dependency_ids(task, data)
        if unresolved:
            print(f"  unresolved_dependency_ids: {', '.join(unresolved)}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
