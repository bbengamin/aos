#!/usr/bin/env python3

import sys

from tasklib import append_execution_event, block_task, find_task, load_tasks, save_tasks, utc_now


def parse_args(argv: list[str]) -> tuple[str | None, str | None]:
    task_id = None
    reason = None
    index = 1
    while index < len(argv):
        arg = argv[index]
        if arg == "--reason":
            index += 1
            if index >= len(argv):
                raise ValueError("missing value for --reason")
            reason = argv[index]
        elif not arg.startswith("--") and task_id is None:
            task_id = arg
        else:
            raise ValueError(f"unknown argument: {arg}")
        index += 1
    return task_id, reason


def main() -> int:
    try:
        task_id, reason = parse_args(sys.argv)
    except ValueError as exc:
        print(f"USAGE_ERROR: {exc}")
        return 1

    if not task_id or not reason:
        print("USAGE_ERROR: block-task <task-id> --reason <text>")
        return 1

    data = load_tasks()
    task = find_task(data, task_id)
    if not task:
        print("TASK_NOT_FOUND")
        return 1

    timestamp = utc_now()
    block_task(task, reason=reason, timestamp=timestamp)
    save_tasks(data)

    append_execution_event(
        {
            "timestamp": timestamp,
            "event": "blocked_by_human",
            "task_id": task["id"],
            "title": task["title"],
            "reason": reason,
        }
    )

    print("TASK_BLOCKED")
    print(f"task_id: {task['id']}")
    print(f"reason: {reason}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
