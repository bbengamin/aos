#!/usr/bin/env python3

import sys

from tasklib import (
    append_execution_event,
    complete_task,
    current_in_progress_task,
    find_task,
    load_tasks,
    save_tasks,
    utc_now,
)


def print_task(task: dict) -> None:
    print(f"task_id: {task['id']}")
    print(f"title: {task['title']}")
    print(f"done_condition: {task['done_condition']}")


def parse_args(argv: list[str]) -> tuple[str | None, str | None]:
    task_id = None
    summary = None
    index = 1
    while index < len(argv):
        arg = argv[index]
        if arg == "--summary":
            index += 1
            if index >= len(argv):
                raise ValueError("missing value for --summary")
            summary = argv[index]
        elif not arg.startswith("--") and task_id is None:
            task_id = arg
        else:
            raise ValueError(f"unknown argument: {arg}")
        index += 1
    return task_id, summary


def main() -> int:
    try:
        task_id, summary = parse_args(sys.argv)
    except ValueError as exc:
        print(f"USAGE_ERROR: {exc}")
        return 1

    if not summary:
        print("USAGE_ERROR: --summary is required")
        return 1

    data = load_tasks()
    task = find_task(data, task_id) if task_id else current_in_progress_task(data)

    if not task:
        print("NO_IN_PROGRESS_TASK")
        return 1

    if task.get("status") != "in_progress":
        print(f"TASK_NOT_IN_PROGRESS: {task['status']}")
        print_task(task)
        return 1

    completed_at = utc_now()
    complete_task(task, timestamp=completed_at, summary=summary)
    save_tasks(data)

    append_execution_event(
        {
            "timestamp": completed_at,
            "event": "completed",
            "task_id": task["id"],
            "title": task["title"],
            "summary": summary,
        }
    )

    print("TASK_COMPLETED")
    print_task(task)
    print(f"summary: {summary}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
